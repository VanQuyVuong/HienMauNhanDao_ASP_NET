<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.Admin.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hệ Thống Hiến Máu Nhân Đạo TP. Đà Nẵng - Quản Trị Viên Hệ Thống (Admin)" 
        Height="820" Width="1350"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#f8fafc">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#0f172a" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO & BRAND -->
                <StackPanel Grid.Row="0" Margin="24,28,24,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#dc2626" Width="44" Height="44" CornerRadius="12">
                            <TextBlock Text="🩸" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="QUẢN TRỊ VIÊN" Foreground="White" FontSize="16" FontWeight="Black"/>
                            <TextBlock Text="SUPER ADMIN SYSTEM" Foreground="#fca5a5" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#1e293b" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- NAVIGATION MENU -->
                <StackPanel Grid.Row="1" Margin="16,0">
                    <!-- Nav Item 1: Quan Ly Nguoi Dung -->
                    <RadioButton x:Name="rbNguoiDung" Style="{StaticResource {x:Type ToggleButton}}" 
                                 Checked="rbNguoiDung_Checked" IsChecked="True" Height="48" Margin="0,0,0,8" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quản Lý Người Dùng" Foreground="#fecdd3" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Nav Item 2: Quan Ly Chien Dich -->
                    <RadioButton x:Name="rbChienDich" Style="{StaticResource {x:Type ToggleButton}}" 
                                 Checked="rbChienDich_Checked" Height="48" Margin="0,0,0,8" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🚩" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quản Lý Chiến Dịch" Foreground="#fecdd3" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Nav Item 3: Cap Giay Chung Nhan -->
                    <RadioButton x:Name="rbChungNhan" Style="{StaticResource {x:Type ToggleButton}}" 
                                 Checked="rbChungNhan_Checked" Height="48" Margin="0,0,0,8" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📜" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cấp Giấy Chứng Nhận" Foreground="#fecdd3" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- Nav Item 4: Quan Ly Benh Vien -->
                    <RadioButton x:Name="rbBenhVien" Style="{StaticResource {x:Type ToggleButton}}" 
                                 Checked="rbBenhVien_Checked" Height="48" Margin="0,0,0,8" Cursor="Hand">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="border" Background="Transparent" CornerRadius="12" Padding="16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🏥" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quản Lý Bệnh Viện" Foreground="#fecdd3" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                </StackPanel>

                <!-- FOOTER / LOGOUT -->
                <Border Grid.Row="2" Padding="20" BorderBrush="#1e293b" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txtAdminEmail" Text="admin@hienmau.vn" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Quyền hạn: Super Admin System" Foreground="#fca5a5" FontSize="10" Margin="0,2,0,12"/>
                        <Button x:Name="btnLogout" Content="🚪  Đăng Xuất" Height="38" Background="#b91c1c" Foreground="White" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Background="#f8fafc">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
