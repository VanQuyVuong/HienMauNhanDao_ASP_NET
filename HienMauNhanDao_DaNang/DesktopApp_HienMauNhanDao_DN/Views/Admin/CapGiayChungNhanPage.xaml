<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.Admin.CapGiayChungNhanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Cấp Giấy Chứng Nhận Hiến Máu">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#991b1b" CornerRadius="16" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="📜 QUẢN LÝ &amp; CẤP GIẤY CHỨNG NHẬN HIẾN MÁU" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="Duyệt và phát hành Giấy chứng nhận hiến máu nhân đạo điện tử cho Tình nguyện viên toàn thành phố" Foreground="#fecdd3" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 LÀM MỚI" Height="38" Padding="14,0" Background="#7f1d1d" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnRefresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnIssueAll" Content="⚡ PHÁT HÀNH TẤT CẢ" Height="38" Padding="16,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnIssueAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS (PENDING vs ISSUED) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabPending" Content="⏳ CHỜ CẤP CHỨNG NHẬN (0)" Height="36" Padding="18,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnTabPending_Click" Margin="0,0,4,0"/>
                <Button x:Name="btnTabIssued" Content="📜 LỊCH SỬ ĐÃ CẤP CHỨNG NHẬN (0)" Height="36" Padding="18,0" Background="Transparent" Foreground="#64748b" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnTabIssued_Click"/>
            </StackPanel>
        </Border>

        <!-- FILTER BAR & SUB TABS -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="36" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                         TextChanged="txtSearch_TextChanged" Margin="0,0,14,0"/>

                <!-- Sub tabs inside History -->
                <StackPanel x:Name="spSubTabs" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Button x:Name="btnSubAll" Content="Tất Cả" Height="32" Padding="12,0" Background="#dc2626" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnSubAll_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnSubChienDich" Content="Theo Chiến Dịch" Height="32" Padding="12,0" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnSubChienDich_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnSubThuongXuyen" Content="Thường Xuyên" Height="32" Padding="12,0" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnSubThuongXuyen_Click" Margin="0,0,4,0"/>
                    <Button x:Name="btnSubCoDinh" Content="Cố Định" Height="32" Padding="12,0" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnSubCoDinh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID + PAGINATION (Fills all remaining height cleanly!) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgCertificates" Grid.Row="0" Margin="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="48" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <!-- CODE -->
                        <DataGridTemplateColumn Header="Mã Đơn / Mã Giấy" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Padding="8,3" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayCode}" Foreground="#c2410c" FontWeight="Black" FontSize="11" FontFamily="Consolas"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Họ và Tên TNV" Binding="{Binding HoVaTen}" Width="170"/>
                        <DataGridTextColumn Header="Số CCCD" Binding="{Binding SoCCCD}" Width="120"/>
                        
                        <DataGridTemplateColumn Header="Nhóm Máu / Thể Tích" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#ea580c" Padding="6,2" CornerRadius="4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding NhomMau}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{Binding TheTich}" FontWeight="Bold" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Ngày Hiến" Binding="{Binding NgayHien}" Width="110"/>
                        <DataGridTextColumn Header="Chiến Dịch Tổ Chức" Binding="{Binding TenChienDich}" Width="*"/>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="Thao Tác" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="📜 CẤP BẰNG" Background="#dc2626" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="Black" Cursor="Hand" Click="btnSingleIssue_Click" Visibility="{Binding PendingVisibility}" Margin="0,0,6,0"/>
                                        <Button Content="👁️ XEM BẰNG" Background="#0284c7" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="Black" Cursor="Hand" Click="btnViewCertDetail_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- PAGINATION TOOLBAR AT BOTTOM -->
                <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hiển thị: " Foreground="#64748b" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbPageSize" Width="90" Height="28" FontSize="11" FontWeight="Bold" SelectionChanged="cbPageSize_SelectionChanged" Margin="4,0,12,0">
                                <ComboBoxItem Content="5 dòng" Tag="5"/>
                                <ComboBoxItem Content="10 dòng" IsSelected="True" Tag="10"/>
                                <ComboBoxItem Content="20 dòng" Tag="20"/>
                            </ComboBox>
                            <TextBlock x:Name="txtPaginationInfo" Text="Đang tải..." Foreground="#0f172a" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPrevPage" Content="◀ Trang trước" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnPrevPage_Click" Margin="0,0,6,0"/>
                            <Border Background="#dc2626" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txtCurrentPage" Text="Trang 1 / 1" Foreground="White" FontSize="11" FontWeight="Black"/>
                            </Border>
                            <Button x:Name="btnNextPage" Content="Trang sau ▶" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnNextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL XEM CHI TIẾT GIẤY CHỨNG NHẬN ĐIỆN TỬ -->
        <Grid x:Name="CertificateDetailModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <StackPanel>
                    <!-- Header Bar -->
                    <Border Background="#991b1b" Padding="24,18" CornerRadius="20,20,0,0">
                        <Grid>
                            <TextBlock Text="📜 THÔNG TIN GIẤY CHỨNG NHẬN HIẾN MÁU ĐIỆN TỬ" Foreground="White" FontSize="15" FontWeight="Black"/>
                            <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseCertModal_Click"/>
                        </Grid>
                    </Border>

                    <!-- Royal Certificate Content Box -->
                    <Border Margin="24" Background="#fffdfa" BorderBrush="#d97706" BorderThickness="3" CornerRadius="16" Padding="28,24">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM" Foreground="#92400e" FontSize="12" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock Text="Độc lập - Tự do - Hạnh phúc" Foreground="#b45309" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,16"/>

                            <Border Background="#fef3c7" CornerRadius="20" Padding="16,6" Margin="0,0,0,16">
                                <TextBlock Text="GIẤY CHỨNG NHẬN HIẾN MÁU NHÂN ĐẠO" Foreground="#991b1b" FontSize="16" FontWeight="Black" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="BAN CHỈ ĐẠO VẬN ĐỘNG HIẾN MÁU NHÂN ĐẠO TP. ĐÀ NẴNG" Foreground="#451a03" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Grid Width="480" Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Chứng nhận Ông/Bà:" Foreground="#78350f" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCertName" Grid.Row="0" Grid.Column="1" Text="---" Foreground="#991b1b" FontSize="13" FontWeight="Black"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Số CCCD / ĐĐD:" Foreground="#78350f" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCertCccd" Grid.Row="1" Grid.Column="1" Text="---" Foreground="#1e293b" FontSize="12" FontWeight="Bold"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Đã hiến máu:" Foreground="#78350f" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCertVolumeGroup" Grid.Row="2" Grid.Column="1" Text="---" Foreground="#ea580c" FontSize="13" FontWeight="Black"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ngày hiến máu:" Foreground="#78350f" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCertDate" Grid.Row="3" Grid.Column="1" Text="---" Foreground="#1e293b" FontSize="12" FontWeight="Bold"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Chiến dịch tổ chức:" Foreground="#78350f" FontSize="12" FontWeight="Bold"/>
                                <TextBlock x:Name="lblCertCampaign" Grid.Row="4" Grid.Column="1" Text="---" Foreground="#15803d" FontSize="12" FontWeight="Bold"/>
                            </Grid>

                            <Border Height="1" Background="#fde68a" Margin="0,0,0,16"/>

                            <Grid Width="480">
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="MÃ CHỨNG NHẬN ĐIỆN TỬ" Foreground="#92400e" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock x:Name="lblCertCode" Text="CN-2026-0000" Foreground="#c2410c" FontSize="14" FontWeight="Black" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Background="#dc2626" Padding="12,4" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ĐÃ XÁC THỰC DIGI-CERT ✅" Foreground="White" FontSize="10" FontWeight="Black"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
