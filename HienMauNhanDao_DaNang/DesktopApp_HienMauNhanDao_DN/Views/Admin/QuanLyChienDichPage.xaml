<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.Admin.QuanLyChienDichPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Quản Lý Chiến Dịch Hiến Máu">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#991b1b" CornerRadius="16" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🚩 QUẢN LÝ CHIẾN DỊCH HIẾN MÁU TOÀN THÀNH PHỐ" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="Khởi tạo, phê duyệt và theo dõi tiến độ thu nhận máu của các chiến dịch hiến máu nhân đạo" Foreground="#fecdd3" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 LÀM MỚI" Height="38" Padding="14,0" Background="#7f1d1d" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnRefresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnCreateCampaign" Content="➕ TẠO CHIẾN DỊCH MỚI" Height="38" Padding="16,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnCreateCampaign_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TỔNG CHIẾN DỊCH" Foreground="#64748b" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="txtKpiTotal" Text="0" Foreground="#0f172a" FontSize="22" FontWeight="Black" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ĐANG DIỄN RA" Foreground="#15803d" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="txtKpiActive" Text="0" Foreground="#16a34a" FontSize="22" FontWeight="Black" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="SẮP TỚI" Foreground="#1d4ed8" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="txtKpiUpcoming" Text="0" Foreground="#2563eb" FontSize="22" FontWeight="Black" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Background="White" BorderBrush="#fef08a" BorderThickness="1" CornerRadius="12" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="ĐÃ KẾT THÚC" Foreground="#a16207" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="txtKpiEnded" Text="0" Foreground="#ca8a04" FontSize="22" FontWeight="Black" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FILTER BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="36" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                         TextChanged="txtSearch_TextChanged" Margin="0,0,14,0"/>

                <ComboBox x:Name="cbFilterStatus" Grid.Column="1" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                          Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                          SelectionChanged="cbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" Tag="ALL"/>
                    <ComboBoxItem Content="Đang diễn ra" Tag="DANG_DIEN_RA"/>
                    <ComboBoxItem Content="Sắp tới" Tag="SAP_TOI"/>
                    <ComboBoxItem Content="Đã kết thúc" Tag="KET_THUC"/>
                    <ComboBoxItem Content="Đã hủy" Tag="DA_HUY"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- DATAGRID + PAGINATION (Fills all remaining height cleanly!) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgCampaigns" Grid.Row="0" Margin="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="48" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <!-- CODE & NAME -->
                        <DataGridTemplateColumn Header="Tên Chiến Dịch / Mã" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TenChienDich}" FontWeight="Bold" FontSize="12" Foreground="#0f172a"/>
                                            <Border Background="#dc2626" Padding="6,1" CornerRadius="4" Visibility="{Binding EmergencyBadgeVisibility}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="🚨 KHẨN CẤP" Foreground="White" FontSize="9" FontWeight="Black"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MaChienDich}" FontSize="10" Foreground="#64748b" FontFamily="Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Địa Điểm Tổ Chức" Binding="{Binding DiaDiemString}" Width="*"/>
                        
                        <DataGridTemplateColumn Header="Thời Gian Tổ Chức" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ThoiGianBD}" FontSize="11" Foreground="#334155"/>
                                        <TextBlock Text=" ➔ " FontSize="11" Foreground="#94a3b8"/>
                                        <TextBlock Text="{Binding ThoiGianKT}" FontSize="11" Foreground="#334155"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Tiến Độ / Chỉ Tiêu" Binding="{Binding ProgressText}" Width="140"/>

                        <!-- STATUS BADGE -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontWeight="Black" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="Thao Tác" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="👁️ XEM" Background="#e0f2fe" Foreground="#0369a1" BorderBrush="#7dd3fc" BorderThickness="1" Padding="5,2" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnViewCampaign_Click" Margin="0,0,4,0"/>
                                        <Button Content="✏️ SỬA" Background="#fef3c7" Foreground="#b45309" BorderBrush="#fde68a" BorderThickness="1" Padding="5,2" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnEditCampaign_Click" Margin="0,0,4,0"/>
                                        <Button Content="🔄 T.THÁI" Background="#f1f5f9" Foreground="#334155" BorderBrush="#cbd5e1" BorderThickness="1" Padding="5,2" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="btnToggleStatus_Click" Margin="0,0,4,0"/>
                                        <Button Content="🗑️ XÓA" Background="#fff1f2" Foreground="#e11d48" BorderBrush="#fca5a5" BorderThickness="1" Padding="5,2" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnDeleteCampaign_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>


                <!-- PAGINATION TOOLBAR AT BOTTOM -->
                <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hiển thị: " Foreground="#64748b" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbPageSize" Width="90" Height="28" FontSize="11" FontWeight="Bold" SelectionChanged="cbPageSize_SelectionChanged" Margin="4,0,12,0">
                                <ComboBoxItem Content="5 dòng" Tag="5"/>
                                <ComboBoxItem Content="10 dòng" IsSelected="True" Tag="10"/>
                                <ComboBoxItem Content="20 dòng" Tag="20"/>
                            </ComboBox>
                            <TextBlock x:Name="txtPaginationInfo" Text="Đang tải..." Foreground="#0f172a" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPrevPage" Content="◀ Trang trước" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnPrevPage_Click" Margin="0,0,6,0"/>
                            <Border Background="#dc2626" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txtCurrentPage" Text="Trang 1 / 1" Foreground="White" FontSize="11" FontWeight="Black"/>
                            </Border>
                            <Button x:Name="btnNextPage" Content="Trang sau ▶" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnNextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL TẠO CHIẾN DỊCH MỚI (100% CHUẨN FLOW WEB) -->
        <Grid x:Name="CreateCampaignModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">

            <Border Background="White" CornerRadius="20" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MaxHeight="820">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- HEADER BAR -->
                        <Border Background="#0f172a" Padding="24,18" CornerRadius="20,20,0,0">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#dc2626" Padding="8,2" CornerRadius="4" Margin="0,0,8,0">
                                            <TextBlock Text="BIỂU MẪU ĐĂNG KÝ MỚI" Foreground="White" FontSize="10" FontWeight="Black"/>
                                        </Border>
                                        <TextBlock Text="• Chuẩn định danh Y tế GIS Đà Nẵng" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="TẠO CHIẾN DỊCH HIẾN MÁU NHÂN ĐẠO MỚI" Foreground="White" FontSize="17" FontWeight="Black" Margin="0,4,0,2"/>
                                    <TextBlock Text="Thiết lập quy mô tổ chức, thời gian và định danh tọa độ điểm tiếp nhận máu chuẩn GIS" Foreground="#cbd5e1" FontSize="11"/>
                                </StackPanel>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="btnCloseModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="24">
                            <!-- PHẦN I: THÔNG TIN ĐỊNH DANH CHIẾN DỊCH & THỜI GIAN -->
                            <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="I. THÔNG TIN ĐỊNH DANH CHIẾN DỊCH &amp; THỜI GIAN" FontSize="13" FontWeight="Black" Foreground="#991b1b" Margin="0,0,0,12"/>

                                    <TextBlock Text="TÊN CHIẾN DỊCH HIẾN MÁU *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNewTenChienDich" Height="40" Padding="12,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="13" FontWeight="Bold" Margin="0,0,0,14"/>

                                    <TextBlock Text="TÍNH CHẤT / MỨC ĐỘ ƯU TIÊN *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton x:Name="rbPriorityNormal" Content="🟢 Bình thường" IsChecked="True" FontSize="12" FontWeight="Bold" Foreground="#0f172a" Margin="0,0,20,0" Checked="rbPriority_Checked"/>
                                        <RadioButton x:Name="rbPriorityEmergency" Content="⚡ Khẩn cấp (Máu cấp cứu)" FontSize="12" FontWeight="Bold" Foreground="#dc2626" Checked="rbPriority_Checked"/>
                                    </StackPanel>

                                    <!-- PANEL NHÓM MÁU CẦN GẤP (KHI CHỌN KHẨN CẤP) -->
                                    <StackPanel x:Name="PanelEmergencyBlood" Visibility="Collapsed" Margin="0,0,0,14">
                                        <TextBlock Text="NHÓM MÁU CẦN GẤP CẤP CỨU *" FontSize="11" FontWeight="Black" Foreground="#dc2626" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbNhomMauCanKhapCap" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#fca5a5" BorderThickness="1.5" FontSize="12" FontWeight="Bold">
                                            <ComboBoxItem Content="Tất cả các nhóm máu" Tag="ALL" IsSelected="True"/>
                                            <ComboBoxItem Content="Nhóm A+" Tag="A_positive"/>
                                            <ComboBoxItem Content="Nhóm B+" Tag="B_positive"/>
                                            <ComboBoxItem Content="Nhóm O+" Tag="O_positive"/>
                                            <ComboBoxItem Content="Nhóm AB+" Tag="AB_positive"/>
                                            <ComboBoxItem Content="Nhóm O-" Tag="O_negative"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="THỜI GIAN BẮT ĐẦU *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker x:Name="dpStartDate" Height="38" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="THỜI GIAN KẾT THÚC (DỰ KIẾN) *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                            <DatePicker x:Name="dpEndDate" Height="38" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="CHỈ TIÊU TIẾP NHẬN (ĐƠN VỊ MÁU) *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                            <TextBox x:Name="txtNewTarget" Text="100" Height="38" Padding="12,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TRẠNG THÁI HOẠT ĐỘNG *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="cbNewTrangThai" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="12" FontWeight="Bold">
                                                <ComboBoxItem Content="🟢 Sắp tới / Mở đăng ký" Tag="0" IsSelected="True"/>
                                                <ComboBoxItem Content="⚡ Đang diễn ra" Tag="1"/>
                                                <ComboBoxItem Content="🔴 Đã kết thúc" Tag="2"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- PHẦN II: THIẾT LẬP VỊ TRÍ & ĐỊA ĐIỂM TIẾP NHẬN MÁU (GIS) -->
                            <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="II. ĐỊNH DANH ĐIỂM HIẾN MÁU &amp; TÍCH HỢP BẢN ĐỒ SỐ GIS ĐÀ NẮNG" FontSize="13" FontWeight="Black" Foreground="#991b1b" Margin="0,0,0,12"/>

                                    <TextBlock Text="CHỌN LOẠI HÌNH TỔ CHỨC ĐỊA ĐIỂM *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton x:Name="rbCodinh" Grid.Column="0" Content="🏥 Cố định tại Bệnh viện / TTYT" IsChecked="True" FontSize="12" FontWeight="Black" Foreground="#0f172a" Checked="rbCampaignType_Checked"/>
                                        <RadioButton x:Name="rbDidong" Grid.Column="2" Content="🚑 Linh động / Di động cộng đồng" FontSize="12" FontWeight="Black" Foreground="#0f172a" Checked="rbCampaignType_Checked"/>
                                    </Grid>

                                    <!-- PANEL CỐ ĐỊNH -->
                                    <StackPanel x:Name="PanelCodinh" Visibility="Visible" Margin="0,0,0,10">
                                        <TextBlock Text="CHỌN BỆNH VIỆN / CƠ SỞ Y TẾ CỐ ĐỊNH TRONG HỆ THỐNG *" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbFixedDiaDiem" Height="40" Padding="12,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>

                                    <!-- PANEL LINH ĐỘNG / DI ĐỘNG (FLOW 5 BƯỚC CHUẨN WEB) -->
                                    <StackPanel x:Name="PanelDidong" Visibility="Collapsed">
                                        <!-- BƯỚC 1: BỘ LỌC PHƯỜNG XÃ -->
                                        <TextBlock Text="BƯỚC 1: CHỌN PHƯỜNG/XÃ TẠI TP. ĐÀ NẮNG *" FontSize="11" FontWeight="Black" Foreground="#0284c7" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="cbNewPhuongXa" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#bae6fd" BorderThickness="1.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,12" SelectionChanged="cbNewPhuongXa_SelectionChanged"/>

                                        <!-- BƯỚC 2: PHÂN LOẠI ĐỊA ĐIỂM -->
                                        <TextBlock Text="BƯỚC 2: PHÂN LOẠI ĐỊA ĐIỂM TỔ CHỨC LƯU ĐỘNG *" FontSize="11" FontWeight="Black" Foreground="#0284c7" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="rbCatSchool" Grid.Column="0" Content="🏫 Trường học" IsChecked="True" FontSize="11" FontWeight="Bold" Checked="rbMobileCat_Checked"/>
                                            <RadioButton x:Name="rbCatMedical" Grid.Column="2" Content="🏥 Trạm y tế" FontSize="11" FontWeight="Bold" Checked="rbMobileCat_Checked"/>
                                            <RadioButton x:Name="rbCatOrg" Grid.Column="4" Content="🏢 Cơ quan" FontSize="11" FontWeight="Bold" Checked="rbMobileCat_Checked"/>
                                            <RadioButton x:Name="rbCatRes" Grid.Column="6" Content="🏡 Khu dân cư" FontSize="11" FontWeight="Bold" Checked="rbMobileCat_Checked"/>
                                        </Grid>

                                        <!-- BƯỚC 3: TÊN ĐIỂM TỔ CHỨC CỤ THỂ + GỢI Ý BẤM NHANH GIS -->
                                        <TextBlock Text="BƯỚC 3: TÊN ĐIỂM TỔ CHỨC CỤ THỂ (TỰ NHẬP HOẶC BẤM GỢI Ý DƯỚI) *" FontSize="11" FontWeight="Black" Foreground="#0284c7" Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtMobileTenDiaDiem" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>

                                        <Border Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="💡 BẤM CHỌN NHANH ĐỊA ĐIỂM GỢI Ý GIS ĐÀ NẮNG:" FontSize="10" FontWeight="Black" Foreground="#0369a1" Margin="0,0,0,6"/>
                                                <WrapPanel x:Name="wpGisSuggestions" Margin="0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- BƯỚC 4: ĐỊA CHỈ CHI TIẾT -->
                                        <TextBlock Text="BƯỚC 4: ĐỊA CHỈ CHI TIẾT ĐIỂM TIẾP NHẬN MÁU *" FontSize="11" FontWeight="Black" Foreground="#0284c7" Margin="0,0,0,6"/>
                                        <TextBox x:Name="txtMobileDiaChi" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" FontSize="12" FontWeight="Bold" Margin="0,0,0,14"/>

                                        <!-- BƯỚC 5: TỌA ĐỘ GIS BẢN ĐỒ VỆ TINH -->
                                        <Border Background="#0f172a" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🧭 BƯỚC 5: TRÍCH XUẤT TỌA ĐỘ GPS BẢN ĐỒ GIS ĐÀ NẮNG" FontSize="11" FontWeight="Black" Foreground="#38bdf8" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="txtGisCoords" Text="📍 Tọa độ GPS: 16.054400°N, 108.202200°E (Khu vực Đà Nẵng)" FontSize="11" Foreground="#4ade80" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- PHẦN III: HÌNH ẢNH TRUYỀN THÔNG & BANNER -->
                            <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="III. BANNER TRUYỀN THÔNG &amp; HÌNH ẢNH MINH HỌA" FontSize="13" FontWeight="Black" Foreground="#991b1b" Margin="0,0,0,12"/>
                                    <Border Background="White" BorderBrush="#cbd5e1" BorderThickness="1.5" CornerRadius="10" Padding="14">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📷 Chọn banner ngang độ phân giải cao (16:9)" FontSize="11" Foreground="#64748b" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                            <Button Content="📁 Chọn tệp hình ảnh từ máy tính" Height="36" Padding="18,0" Background="#0f172a" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnSelectBannerFile_Click"/>
                                            <TextBlock x:Name="txtSelectedBannerPath" Text="Chưa chọn tệp ảnh nào" FontSize="10" Foreground="#94a3b8" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- FOOTER BUTTONS -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="HỦY BỎ" Height="42" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseModal_Click"/>
                                <Button Grid.Column="2" Content="🚀 TẠO &amp; PHÁT HÀNH CHIẾN DỊCH" Height="42" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitCreateCampaign_Click"/>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL XEM CHI TIẾT CHIẾN DỊCH -->

        <Grid x:Name="ViewCampaignDetailModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MaxHeight="780">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#0369a1" Padding="20,16" CornerRadius="20,20,0,0">
                            <Grid>
                                <TextBlock Text="👁️ CHI TIẾT CHIẾN DỊCH &amp; DANH SÁCH ĐĂNG KÝ" Foreground="White" FontSize="15" FontWeight="Black"/>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseViewModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="20">
                            <Border Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="txtViewTenChienDich" Text="Tên chiến dịch" FontSize="16" FontWeight="Black" Foreground="#0369a1"/>
                                    <TextBlock x:Name="txtViewMaChienDich" Text="Mã: CD00001" FontSize="11" Foreground="#0284c7" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="txtViewDiaDiem" Text="📍 Địa điểm: Bệnh viện Đà Nẵng" FontSize="12" FontWeight="Bold" Foreground="#0f172a" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="txtViewThoiGian" Text="📅 Thời gian: 01/09/2026 ➔ 15/09/2026" FontSize="11" Foreground="#475569" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="txtViewChiTieu" Text="🎯 Chỉ tiêu: 350.000 ml" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="txtViewTrangThai" Text="⚡ Trạng thái: Đang diễn ra" FontSize="11" FontWeight="Bold" Foreground="#16a34a" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="DANH SÁCH ĐƠN ĐĂNG KÝ TÌNH NGUYỆN VIÊN (ĐÃ TIẾP NHẬN)" FontSize="11" FontWeight="Black" Foreground="#475569" Margin="0,0,0,8"/>
                            <DataGrid x:Name="dgViewRegistrations" Height="220" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="38" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="90"/>
                                    <DataGridTextColumn Header="Họ và Tên TNV" Binding="{Binding HoTenTNV}" Width="160"/>
                                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding SoDienThoai}" Width="120"/>
                                    <DataGridTextColumn Header="Nhóm Máu" Binding="{Binding NhomMau}" Width="80"/>
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TrangThaiText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="ĐÓNG BẢNG CHI TIẾT" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,16,0,0" Click="btnCloseViewModal_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL SỬA CHIẾN DỊCH -->
        <Grid x:Name="EditCampaignModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MaxHeight="720">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#b45309" Padding="20,16" CornerRadius="20,20,0,0">
                            <Grid>
                                <TextBlock Text="✏️ CHỈNH SỬA THÔNG TIN CHIẾN DỊCH" Foreground="White" FontSize="15" FontWeight="Black"/>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseEditModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="20">
                            <TextBlock Text="TÊN CHIẾN DỊCH HIẾN MÁU *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEditTenChienDich" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14"/>

                            <TextBlock Text="CHỈ TIÊU ML MÁU DỰ KIẾN *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEditTarget" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14"/>

                            <TextBlock Text="TRẠNG THÁI CHIẾN DỊCH *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbEditTrangThai" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,20">
                                <ComboBoxItem Content="🟢 Sắp tới / Mở đăng ký" Tag="0"/>
                                <ComboBoxItem Content="⚡ Đang diễn ra tiếp nhận" Tag="1"/>
                                <ComboBoxItem Content="🔴 Đã kết thúc chiến dịch" Tag="2"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="HỦY BỎ" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseEditModal_Click"/>
                                <Button Grid.Column="2" Content="💾 LƯU THAY ĐỔI" Height="40" Background="#b45309" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitEditCampaign_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>



