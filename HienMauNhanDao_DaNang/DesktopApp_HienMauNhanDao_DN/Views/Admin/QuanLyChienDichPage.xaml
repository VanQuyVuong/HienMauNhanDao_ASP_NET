<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.Admin.QuanLyChienDichPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="Quản Lý Chiến Dịch Hiến Máu">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BANNER -->
            <Border Grid.Row="0" Background="#991b1b" CornerRadius="18" Padding="24,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🚩 QUẢN LÝ CHIẾN DỊCH HIẾN MÁU TOÀN THÀNH PHỐ" Foreground="White" FontSize="20" FontWeight="Black"/>
                        <TextBlock Text="Khởi tạo, phê duyệt và theo dõi tiến độ thu nhận máu của các chiến dịch hiến máu nhân đạo" Foreground="#fecdd3" FontSize="13" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnRefresh" Content="🔄 LÀM MỚI" Height="40" Padding="16,0" Background="#7f1d1d" Foreground="White" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnRefresh_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnCreateCampaign" Content="➕ TẠO CHIẾN DỊCH MỚI" Height="40" Padding="18,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnCreateCampaign_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI CARDS -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="TỔNG CHIẾN DỊCH" Foreground="#64748b" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="txtKpiTotal" Text="0" Foreground="#0f172a" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#bbf7d0" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ĐANG DIỄN RA" Foreground="#15803d" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="txtKpiActive" Text="0" Foreground="#16a34a" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="White" BorderBrush="#bfdbfe" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="SẮP TỚI" Foreground="#1d4ed8" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="txtKpiUpcoming" Text="0" Foreground="#2563eb" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Background="White" BorderBrush="#fef08a" BorderThickness="1" CornerRadius="14" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="ĐÃ KẾT THÚC" Foreground="#a16207" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="txtKpiEnded" Text="0" Foreground="#ca8a04" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FILTER BAR -->
            <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtSearch" Grid.Column="0" Height="40" Padding="14,0" VerticalContentAlignment="Center"
                             Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="13"
                             TextChanged="txtSearch_TextChanged" Margin="0,0,12,0"/>

                    <ComboBox x:Name="cbFilterStatus" Grid.Column="1" Height="40" FontSize="13" FontWeight="Bold" SelectionChanged="cbFilterStatus_SelectionChanged">
                        <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="Đang diễn ra" Tag="DANG_DIEN_RA"/>
                        <ComboBoxItem Content="Sắp tới" Tag="SAP_TOI"/>
                        <ComboBoxItem Content="Đã kết thúc" Tag="KET_THUC"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- DATAGRID + PAGINATION -->
            <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="dgCampaigns" Grid.Row="0" Margin="-1" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                              RowHeight="54" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9">
                        <DataGrid.Columns>
                            <!-- CAMPAIGN NAME -->
                            <DataGridTemplateColumn Header="Tên Chiến Dịch Hiến Máu" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TenChienDich}" FontWeight="Black" FontSize="13" Foreground="#0f172a"/>
                                            <TextBlock Text="{Binding DiaDiemString}" Foreground="#64748b" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Thời Gian Bắt Đầu" Binding="{Binding ThoiGianBD}" Width="150"/>
                            <DataGridTextColumn Header="Thời Gian Kết Thúc" Binding="{Binding ThoiGianKT}" Width="150"/>
                            <DataGridTextColumn Header="Chỉ Tiêu / Đã Thu" Binding="{Binding ProgressText}" Width="140"/>

                            <!-- STATUS -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBg}" Padding="10,4" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontWeight="Black" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ACTIONS -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⚙️ Đổi Trạng Thái" Background="#f8fafc" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" Padding="8,4" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnToggleStatus_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- PAGINATION -->
                    <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hiển thị: " Foreground="#64748b" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cbPageSize" Width="90" Height="28" FontSize="11" FontWeight="Bold" SelectionChanged="cbPageSize_SelectionChanged" Margin="4,0,12,0">
                                    <ComboBoxItem Content="5 dòng" IsSelected="True" Tag="5"/>
                                    <ComboBoxItem Content="10 dòng" Tag="10"/>
                                    <ComboBoxItem Content="20 dòng" Tag="20"/>
                                </ComboBox>
                                <TextBlock x:Name="txtPaginationInfo" Text="Đang tải..." Foreground="#0f172a" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="btnPrevPage" Content="◀ Trang trước" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnPrevPage_Click" Margin="0,0,6,0"/>
                                <Border Background="#dc2626" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock x:Name="txtCurrentPage" Text="Trang 1 / 1" Foreground="White" FontSize="11" FontWeight="Black"/>
                                </Border>
                                <Button x:Name="btnNextPage" Content="Trang sau ▶" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnNextPage_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- MODAL TẠO CHIẾN DỊCH MỚI -->
            <Grid x:Name="CreateCampaignModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
                <Border Background="White" CornerRadius="20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                    <StackPanel>
                        <Border Background="#dc2626" Padding="24,18" CornerRadius="20,20,0,0">
                            <Grid>
                                <TextBlock Text="➕ TẠO CHIẾN DỊCH HIẾN MÁU MỚI" Foreground="White" FontSize="16" FontWeight="Black"/>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="24">
                            <TextBlock Text="TÊN CHIẾN DỊCH HIẾN MÁU *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNewTenChienDich" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="13" Margin="0,0,0,14"/>

                            <TextBlock Text="TÊN ĐỊA ĐIỂM TỔ CHỨC *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNewDiaDiem" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="13" Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NGÀY BẮT ĐẦU *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="dpStartDate" Height="38" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="NGÀY KẾT THÚC *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <DatePicker x:Name="dpEndDate" Height="38" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="CHỈ TIÊU SỐ TÚI MÁU (ĐƠN VỊ) *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNewTarget" Text="100" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="13" Margin="0,0,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="HỦY BỎ" Height="42" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseModal_Click"/>
                                <Button Grid.Column="2" Content="XÁC NHẬN TẠO" Height="42" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitCreateCampaign_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
