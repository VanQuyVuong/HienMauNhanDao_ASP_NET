<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.Admin.QuanLyNguoiDungPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Quản Lý Người Dùng &amp; Phân Quyền">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#991b1b" CornerRadius="16" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="👥 QUẢN LÝ NGƯỜI DÙNG &amp; PHÂN QUYỀN HỆ THỐNG" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="Quản lý danh sách tài khoản Cán bộ y tế, Bác sĩ, Thủ kho và Tình nguyện viên toàn thành phố" Foreground="#fecdd3" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 LÀM MỚI" Height="38" Padding="14,0" Background="#7f1d1d" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnRefresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnOpenCreateModal" Content="➕ TẠO TÀI KHOẢN MỚI" Height="38" Padding="16,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnOpenCreateModal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB-TABS (NỘI BỘ vs TNV) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabInternal" Content="💻 CÁN BỘ NỘI BỘ (NVYT / BS / QLK / AD)" Height="36" Padding="18,0" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnTabInternal_Click" Margin="0,0,4,0"/>
                <Button x:Name="btnTabTnv" Content="🩸 TÌNH NGUYỆN VIÊN (NGƯỜI HIẾN MÁU)" Height="36" Padding="18,0" Background="Transparent" Foreground="#64748b" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnTabTnv_Click"/>
            </StackPanel>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="36" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                         TextChanged="txtSearch_TextChanged" Margin="0,0,14,0"/>

                <ComboBox x:Name="cbFilterRole" Grid.Column="1" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                          Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                          SelectionChanged="cbFilterRole_SelectionChanged">
                    <ComboBoxItem Content="Tất cả vai trò" IsSelected="True" Tag="ALL"/>
                    <ComboBoxItem Content="Quản trị viên (AD)" Tag="AD"/>
                    <ComboBoxItem Content="Bác sĩ (BS)" Tag="BS"/>
                    <ComboBoxItem Content="Nhân viên y tế (NVYT)" Tag="NVYT"/>
                    <ComboBoxItem Content="Nhân viên xét nghiệm (NVXN)" Tag="NVYT-XN"/>
                    <ComboBoxItem Content="Quản lý kho (QLK)" Tag="QLK"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- DATAGRID + PAGINATION (Fills all remaining height cleanly!) -->
        <Border Grid.Row="3" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgUsers" Grid.Row="0" Margin="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="48" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <!-- EMAIL / USERNAME -->
                        <DataGridTemplateColumn Header="Tài Khoản / Email" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Email}" FontWeight="Bold" FontSize="12" Foreground="#0f172a"/>
                                        <TextBlock Text="{Binding MaTaiKhoan}" FontSize="10" Foreground="#64748b" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Họ và Tên" Binding="{Binding HoTen}" Width="160"/>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding SoDienThoai}" Width="120"/>

                        <!-- ROLE BADGE -->
                        <DataGridTemplateColumn Header="Vai Trò / Phân Quyền" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RoleBg}" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding RoleFg}" FontWeight="Black" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Đơn Vị / Bệnh Viện" Binding="{Binding TenKhoa}" Width="*"/>

                        <!-- STATUS BADGE -->
                        <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontWeight="Bold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="Thao Tác" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✏️ SỬA" Background="#fef3c7" Foreground="#b45309" BorderBrush="#fde68a" BorderThickness="1" Padding="6,3" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnEditUser_Click" Margin="0,0,4,0"/>
                                        <Button Content="{Binding ActionBtnText}" Background="{Binding ActionBtnBg}" Foreground="{Binding ActionBtnFg}" BorderBrush="{Binding ActionBtnBorder}" BorderThickness="1" Padding="6,3" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnToggleLock_Click" Margin="0,0,4,0"/>
                                        <Button Content="👤 BẢO MẬT" Background="#e0f2fe" Foreground="#0369a1" BorderBrush="#7dd3fc" BorderThickness="1" Padding="6,3" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnOpenProfileSecurity_Click" Margin="0,0,4,0"/>
                                        <Button Content="🗑️ XÓA" Background="#fff1f2" Foreground="#e11d48" BorderBrush="#fca5a5" BorderThickness="1" Padding="6,3" FontSize="10" FontWeight="Black" Cursor="Hand" Click="btnDeleteUser_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- PAGINATION TOOLBAR AT BOTTOM -->
                <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hiển thị: " FontSize="11" Foreground="#64748b" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbPageSize" Height="28" Padding="6,0" FontSize="11" FontWeight="Bold" SelectionChanged="cbPageSize_SelectionChanged">
                                <ComboBoxItem Content="10 dòng" IsSelected="True" Tag="10"/>
                                <ComboBoxItem Content="20 dòng" Tag="20"/>
                                <ComboBoxItem Content="50 dòng" Tag="50"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="txtPaginationInfo" Grid.Column="1" Text="Hiển thị 1 - 10 trong tổng số 0 tài khoản" FontSize="11" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPrevPage" Content="◀ Trang trước" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnPrevPage_Click" Margin="0,0,6,0"/>
                            <Border Background="#dc2626" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txtCurrentPage" Text="Trang 1 / 1" Foreground="White" FontSize="11" FontWeight="Black"/>
                            </Border>
                            <Button x:Name="btnNextPage" Content="Trang sau ▶" Height="28" Padding="10,0" Background="White" Foreground="#dc2626" BorderBrush="#fca5a5" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnNextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL TẠO TÀI KHOẢN CÁN BỘ MỚI (ĐẦY ĐỦ THÔNG TIN HỒ SƠ) -->
        <Grid x:Name="CreateUserModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MaxHeight="780">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#991b1b" Padding="20,16" CornerRadius="20,20,0,0">
                            <Grid>
                                <TextBlock Text="➕ TẠO TÀI KHOẢN CÁN BỘ MỚI" Foreground="White" FontSize="15" FontWeight="Black"/>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="20">
                            <!-- Họ và tên -->
                            <TextBlock Text="HỌ VÀ TÊN CÁN BỘ *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNewHoTen" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>

                            <!-- SĐT & CCCD -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNewSoDienThoai" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SỐ CCCD / CMND *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtNewCccd" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Khoa / Đơn vị công tác -->
                            <TextBlock Text="KHOA / ĐƠN VỊ CÔNG TÁC *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbNewKhoa" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>

                            <!-- Email đăng nhập -->
                            <TextBlock Text="EMAIL ĐĂNG NHẬP *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtNewEmail" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>

                            <!-- Mật khẩu khởi tạo -->
                            <TextBlock Text="MẬT KHẨU KHỞI TẠO *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="txtNewPassword" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>

                            <!-- Vai trò / Phân quyền -->
                            <TextBlock Text="VAI TRÒ / PHÂN QUYỀN *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbNewRole" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,20">
                                <ComboBoxItem Content="👑 Quản trị viên hệ thống (AD)" Tag="AD"/>
                                <ComboBoxItem Content="🏥 Admin Bệnh viện / Trung tâm (ADMIN_BV)" Tag="ADMIN_BV"/>
                                <ComboBoxItem Content="🩺 Bác sĩ khám lâm sàng (BS)" IsSelected="True" Tag="BS"/>
                                <ComboBoxItem Content="💉 Nhân viên y tế lấy máu (NVYT)" Tag="NVYT"/>
                                <ComboBoxItem Content="🔬 Nhân viên xét nghiệm (NVXN)" Tag="NVYT_XN"/>
                                <ComboBoxItem Content="📋 Nhân viên lễ tân / tiếp nhận (NVLT)" Tag="NVYT_LT"/>
                                <ComboBoxItem Content="📦 Quản lý kho máu (QLK)" Tag="QLK"/>
                            </ComboBox>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="HỦY BỎ" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseModal_Click"/>
                                <Button Grid.Column="2" Content="🚀 XÁC NHẬN TẠO CÁN BỘ" Height="40" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitCreateUser_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL CẬP NHẬT THÔNG TIN TÀI KHOẢN CÁN BỘ (KHI ĐỔI NHÂN VIÊN / CHUYỂN CÔNG TÁC) -->
        <Grid x:Name="EditUserModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" MaxHeight="780">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#d97706" Padding="20,16" CornerRadius="20,20,0,0">
                            <Grid>
                                <TextBlock Text="✏️ CẬP NHẬT THÔNG TIN CÁN BỘ" Foreground="White" FontSize="15" FontWeight="Black"/>
                                <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseEditUserModal_Click"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="20">
                            <Border Background="#fef3c7" BorderBrush="#fde68a" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                                <TextBlock x:Name="txtEditUserAccountHeader" Text="Tài khoản: admin@danang.gov.vn (TK00034)" FontSize="12" FontWeight="Bold" Foreground="#92400e"/>
                            </Border>

                            <!-- Họ và tên -->
                            <TextBlock Text="HỌ VÀ TÊN CÁN BỘ THAY THẾ *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtEditHoTen" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>

                            <!-- SĐT & CCCD -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SỐ ĐIỆN THOẠI *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtEditSoDienThoai" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SỐ CCCD / CMND *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtEditCccd" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Khoa / Đơn vị công tác -->
                            <TextBlock Text="KHOA / ĐƠN VỊ CÔNG TÁC MỚI *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cbEditKhoa" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,12"/>


                            <!-- Vai trò & Trạng thái -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="VAI TRỜ / PHÂN QUYỀN *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cbEditRole" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12">
                                        <ComboBoxItem Content="👑 Quản trị viên (AD)" Tag="AD"/>
                                        <ComboBoxItem Content="🏥 Admin Bệnh viện (ADMIN_BV)" Tag="ADMIN_BV"/>
                                        <ComboBoxItem Content="🩺 Bác sĩ khám lâm sàng (BS)" Tag="BS"/>
                                        <ComboBoxItem Content="💉 Nhân viên y tế lấy máu (NVYT)" Tag="NVYT"/>
                                        <ComboBoxItem Content="🔬 Nhân viên xét nghiệm (NVXN)" Tag="NVYT_XN"/>
                                        <ComboBoxItem Content="📋 Nhân viên lễ tân (NVLT)" Tag="NVYT_LT"/>
                                        <ComboBoxItem Content="📦 Quản lý kho máu (QLK)" Tag="QLK"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TRẠNG THÁI TÀI KHOẢN *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cbEditTrangThai" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12">
                                        <ComboBoxItem Content="🟢 HOẠT ĐỘNG" Tag="TRUE" IsSelected="True"/>
                                        <ComboBoxItem Content="🔴 VÔ HIỆU / KHÓA" Tag="FALSE"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="HỦY BỎ" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseEditUserModal_Click"/>
                                <Button Grid.Column="2" Content="💾 LƯU CẬP NHẬT" Height="40" Background="#d97706" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitEditUser_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- MODAL 1: XÁC NHẬN MẬT KHẨU ADMIN -->
        <Grid x:Name="AdminAuthModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <StackPanel>
                    <Border Background="#1e293b" Padding="20,16" CornerRadius="20,20,0,0">
                        <Grid>
                            <TextBlock Text="🔐 XÁC NHẬN MẬT KHẨU ADMIN" Foreground="White" FontSize="15" FontWeight="Black"/>
                            <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseAdminAuthModal_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="20">
                        <TextBlock Text="Vui lòng nhập mật khẩu Admin để truy cập thông tin Hồ sơ &amp; Bảo mật tài khoản này:" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="MẬT KHẨU ADMIN *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                        <PasswordBox x:Name="txtAdminConfirmPassword" Height="40" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="13" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="HỦY BỎ" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseAdminAuthModal_Click"/>
                            <Button Grid.Column="2" Content="XÁC NHẬN" Height="40" Background="#0f172a" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnVerifyAdminPassword_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL 2: HỒ SƠ CHI TIẾT & CẤP LẠI MẬT KHẨU MỚI -->
        <Grid x:Name="UserProfileDetailModal" Grid.RowSpan="4" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <StackPanel>
