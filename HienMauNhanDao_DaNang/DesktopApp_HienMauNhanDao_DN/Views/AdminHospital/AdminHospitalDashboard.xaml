<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.AdminHospital.AdminHospitalDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hệ Thống Hiến Máu Nhân Đạo TP. Đà Nẵng - Quản Trị Bệnh Viện (Admin_BV)" 
        Height="880" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">

    <Grid Background="#f8fafc">
        <Grid.ColumnDefinitions>
            <!-- SIDEBAR COLUMN -->
            <ColumnDefinition Width="260"/>
            <!-- MAIN CONTENT COLUMN -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR CONTAINER (Unified Deep Navy & Red Accent Theme) -->
        <Border Grid.Column="0" Background="#0f172a" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- BRANDING HEADER -->
                <Border Grid.Row="0" Padding="20,24" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="44" Height="44" Background="#dc2626" CornerRadius="12">
                            <TextBlock Text="🏥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ADMIN BỆNH VIỆN" Foreground="White" FontSize="15" FontWeight="Black"/>
                            <TextBlock x:Name="lblHospitalName" Text="Bệnh viện C Đà Nẵng" Foreground="#fca5a5" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- NAVIGATION MENU -->
                <StackPanel Grid.Row="1" Margin="12,20">
                    <Button x:Name="btnNavDashboard" Content="📊  Bảng Điều Khiển" Height="46" Margin="0,0,0,8"
                            Background="#dc2626" Foreground="White" FontWeight="Bold" FontSize="13"
                            HorizontalContentAlignment="Left" Padding="16,0" Cursor="Hand" Click="btnNavDashboard_Click"/>

                    <Button x:Name="btnNavNhanSu" Content="👨‍⚕️  Quản Lý Nhân Sự" Height="46" Margin="0,0,0,8"
                            Background="Transparent" Foreground="#cbd5e1" FontWeight="SemiBold" FontSize="13"
                            HorizontalContentAlignment="Left" Padding="16,0" Cursor="Hand" Click="btnNavNhanSu_Click"/>

                    <Button x:Name="btnNavKhoMau" Content="🩸  Quản Lý Kho Máu" Height="46" Margin="0,0,0,8"
                            Background="Transparent" Foreground="#cbd5e1" FontWeight="SemiBold" FontSize="13"
                            HorizontalContentAlignment="Left" Padding="16,0" Cursor="Hand" Click="btnNavKhoMau_Click"/>

                    <Button x:Name="btnNavTinTuc" Content="📣  Tin Tức &amp; Thông Báo" Height="46" Margin="0,0,0,8"
                            Background="Transparent" Foreground="#cbd5e1" FontWeight="SemiBold" FontSize="13"
                            HorizontalContentAlignment="Left" Padding="16,0" Cursor="Hand" Click="btnNavTinTuc_Click"/>

                    <Button x:Name="btnNavChienDich" Content="🩸  Chiến Dịch Hiến Máu" Height="46" Margin="0,0,0,8"
                            Background="Transparent" Foreground="#cbd5e1" FontWeight="SemiBold" FontSize="13"
                            HorizontalContentAlignment="Left" Padding="16,0" Cursor="Hand" Click="btnNavChienDich_Click"/>
                </StackPanel>

                <!-- FOOTER / LOGOUT -->
                <Border Grid.Row="2" Padding="20" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock x:Name="txtAdminEmail" Text="adminbv@bvdn.vn" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Quyền hạn: Admin Bệnh Viện (ADMIN_BV)" Foreground="#fca5a5" FontSize="10" Margin="0,2,0,12"/>
                        <Button x:Name="btnLogout" Content="🚪  Đăng Xuất" Height="38" Background="#b91c1c" Foreground="White" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT FRAME -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="0"/>
    </Grid>
</Window>
