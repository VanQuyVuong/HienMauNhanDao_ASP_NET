<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.AdminHospital.QuanLyNhanSuBVPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Quản Lý Nhân Sự Bệnh Viện">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#0f766e" CornerRadius="16" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="👨‍⚕️ QUẢN LÝ NHÂN SỰ Y TẾ BỆNH VIỆN" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="Danh sách Cán bộ, Bác sĩ, Nhân viên y tế, Nhân viên xét nghiệm và Thủ kho thuộc Bệnh viện" Foreground="#ccfbf1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh" Content="🔄 LÀM MỚI" Height="38" Padding="14,0" Background="#0d9488" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="btnRefresh_Click" Margin="0,0,8,0"/>
                    <Button x:Name="btnOpenCreateModal" Content="➕ THÊM CÁN BỘ MỚI" Height="38" Padding="16,0" Background="#14b8a6" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnOpenCreateModal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER BAR -->
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="36" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                         TextChanged="txtSearch_TextChanged" Margin="0,0,14,0"/>

                <ComboBox x:Name="cbFilterRole" Grid.Column="1" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                          Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12"
                          SelectionChanged="cbFilterRole_SelectionChanged">
                    <ComboBoxItem Content="Tất cả vai trò" IsSelected="True" Tag="ALL"/>
                    <ComboBoxItem Content="Bác sĩ (BS)" Tag="BS"/>
                    <ComboBoxItem Content="Nhân viên y tế (NVYT)" Tag="NVYT"/>
                    <ComboBoxItem Content="Nhân viên xét nghiệm (NVXN)" Tag="NVYT-XN"/>
                    <ComboBoxItem Content="Quản lý kho (QLK)" Tag="QLK"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- DATAGRID + PAGINATION TOOLBAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" ClipToBounds="True" VerticalAlignment="Stretch">
            <Grid VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="dgStaff" Grid.Row="0" Margin="0" AutoGenerateColumns="False" 
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                          RowHeight="42" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#f1f5f9"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <DataGrid.Columns>
                        <!-- CODE & NAME -->
                        <DataGridTemplateColumn Header="Mã Cán Bộ / Họ và Tên" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HoTenDisplay}" FontWeight="Bold" FontSize="12" Foreground="#0f172a"/>
                                        <TextBlock Text="{Binding MaNhanVien}" FontSize="10" Foreground="#64748b" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Email Đăng Nhập" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding SoDienThoai}" Width="130"/>
                        <DataGridTextColumn Header="Số CCCD" Binding="{Binding CCCD}" Width="130"/>

                        <!-- ROLE BADGE -->
                        <DataGridTemplateColumn Header="Vai Trò / Nhiệm Vụ" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding RoleBg}" Padding="8,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RoleLabel}" Foreground="{Binding RoleFg}" FontWeight="Black" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- PAGINATION TOOLBAR -->
                <Border Grid.Row="1" Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hiển thị: " Foreground="#64748b" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cbPageSize" Width="90" Height="28" FontSize="11" FontWeight="Bold" SelectionChanged="cbPageSize_SelectionChanged" Margin="4,0,12,0">
                                <ComboBoxItem Content="5 dòng" Tag="5"/>
                                <ComboBoxItem Content="10 dòng" IsSelected="True" Tag="10"/>
                                <ComboBoxItem Content="20 dòng" Tag="20"/>
                            </ComboBox>
                            <TextBlock x:Name="txtPaginationInfo" Text="Đang tải..." Foreground="#0f172a" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnPrevPage" Content="◀ Trang trước" Height="28" Padding="10,0" Background="White" Foreground="#0f766e" BorderBrush="#99f6e4" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnPrevPage_Click" Margin="0,0,6,0"/>
                            <Border Background="#0f766e" CornerRadius="4" Padding="10,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="txtCurrentPage" Text="Trang 1 / 1" Foreground="White" FontSize="11" FontWeight="Black"/>
                            </Border>
                            <Button x:Name="btnNextPage" Content="Trang sau ▶" Height="28" Padding="10,0" Background="White" Foreground="#0f766e" BorderBrush="#99f6e4" BorderThickness="1" FontSize="11" FontWeight="Bold" Cursor="Hand" Click="btnNextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- MODAL THÊM CÁN BỘ MỚI -->
        <Grid x:Name="CreateStaffModal" Grid.RowSpan="3" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="White" CornerRadius="20" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0">
                <StackPanel>
                    <Border Background="#0f766e" Padding="20,16" CornerRadius="20,20,0,0">
                        <Grid>
                            <TextBlock Text="➕ THÊM CÁN BỘ BỆNH VIỆN MỚI" Foreground="White" FontSize="15" FontWeight="Black"/>
                            <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="18" FontWeight="Black" HorizontalAlignment="Right" Cursor="Hand" Click="btnCloseModal_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="20">
                        <TextBlock Text="HỌ VÀ TÊN CÁN BỘ *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNewHoTen" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14"/>

                        <TextBlock Text="EMAIL ĐĂNG NHẬP *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNewEmail" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14"/>

                        <TextBlock Text="VAI TRÒ / NHIỆM VỤ *" FontSize="11" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cbNewRole" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,20">
                            <ComboBoxItem Content="Bác sĩ khám lâm sàng (BS)" IsSelected="True" Tag="BS"/>
                            <ComboBoxItem Content="Nhân viên y tế (NVYT)" Tag="NVYT"/>
                            <ComboBoxItem Content="Nhân viên xét nghiệm (NVXN)" Tag="NVYT-XN"/>
                            <ComboBoxItem Content="Quản lý kho máu (QLK)" Tag="QLK"/>
                        </ComboBox>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="HỦY BỎ" Height="40" Background="#f1f5f9" Foreground="#475569" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="btnCloseModal_Click"/>
                            <Button Grid.Column="2" Content="XÁC NHẬN THÊM" Height="40" Background="#0f766e" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitCreateStaff_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
