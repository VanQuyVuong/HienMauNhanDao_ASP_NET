<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.BacSi.KhamLamSangPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Khám Lâm Sàng" Background="#f8fafc" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ffe4e6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fff1f2"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ffe4e6"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="50"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#fff1f2"/>
            <Setter Property="Foreground" Value="#9f1239"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#fecdd3"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <!-- Header Gradient Banner -->
            <Border CornerRadius="22" Padding="28,24" Margin="0,0,0,24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#e11d48" Offset="0.0"/>
                        <GradientStop Color="#dc2626" Offset="0.5"/>
                        <GradientStop Color="#d97706" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="#33ffffff" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="🩸 BÁC SĨ CHUYÊN KHOA KHÁM LÂM SÀNG" Foreground="White" FontSize="12" FontWeight="Black"/>
                        </Border>
                        <TextBlock Text="Trạm Đo Sinh Hiệu &amp; Phê Duyệt Sức Khỏe Hiến Máu" Foreground="White" FontSize="25" FontWeight="Black"/>
                        <TextBlock Text="Nhập 4 chỉ số sinh hiệu y tế, đánh giá điều kiện thể trạng TNV &amp; chuyển đơn đủ điều kiện sang phòng thu nhận túi máu" 
                                   Foreground="#ffe4e6" FontSize="13" FontWeight="Medium" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Header Tab Switcher -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Background="#33ffffff" Padding="5" CornerRadius="16">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnTabNew" Content="🩺 Nhập Sinh Hiệu Mới" Height="42" Padding="20,0" 
                                    Background="White" Foreground="#be123c" FontWeight="Black" FontSize="13" 
                                    Cursor="Hand" BorderThickness="0" Click="btnTabNew_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="btnTabHistory" Content="📋 Lịch Sử Khám Lần Trước" Height="42" Padding="20,0" Margin="6,0,0,0"
                                    Background="Transparent" Foreground="White" FontWeight="Bold" FontSize="13" 
                                    Cursor="Hand" BorderThickness="0" Click="btnTabHistory_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- VIEW 1: FORM KHÁM (2 Column Layout) -->
            <Grid x:Name="ViewFormKham">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: Search & Donor Dossier -->
                <StackPanel Grid.Column="0">
                    <!-- Quick Call Search Bar Card -->
                    <Border Background="White" BorderBrush="#ffe4e6" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🔍 GỌI HỒ SƠ TÌNH NGUYỆN VIÊN (MÃ ĐƠN / QR CODE)" FontSize="12" FontWeight="Black" Foreground="#475569" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtMaDonSearch" Grid.Column="0" Height="46" Padding="14,0" BorderBrush="#fecdd3" BorderThickness="1.5" 
                                         VerticalContentAlignment="Center" FontSize="14" FontWeight="Black" Foreground="#0f172a" 
                                         Margin="0,0,10,0" KeyUp="txtMaDonSearch_KeyUp" Tag="Nhập mã đơn (VD: DK00001)..."/>
                                <Button x:Name="btnFind" Grid.Column="1" Content="Gọi Đơn" Height="46" Padding="22,0" 
                                        Background="#e11d48" Foreground="White" FontWeight="Black" FontSize="13" 
                                        Cursor="Hand" BorderThickness="0" Click="btnFind_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Empty Placeholder State -->
                    <Border x:Name="EmptyPlaceholder" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" CornerRadius="18" Padding="28,48" Margin="0,0,0,20">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👤" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Vui lòng nhập mã đơn hoặc chọn TNV từ Danh sách chờ ở Menu bên trái để tiến hành khám." 
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#9f1239" FontSize="13" FontWeight="Bold" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- Donor Card Dossier (Gradient Red Card) -->
                    <Border x:Name="DonorCard" CornerRadius="18" Padding="24" Margin="0,0,0,20" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#e11d48" Offset="0.0"/>
                                <GradientStop Color="#be123c" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <!-- Header Donor Info -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="14" Background="#33ffffff" Margin="0,0,14,0">
                                    <TextBlock x:Name="txtCardInitial" Text="A" FontSize="24" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCardHoTen" Text="Nguyễn Văn A" FontSize="18" FontWeight="Black" Foreground="White"/>
                                    <TextBlock x:Name="txtCardMaDon" Text="Mã đơn: DK00001" FontSize="12" Foreground="#ffe4e6" FontWeight="Bold" Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="White" Padding="14,6" CornerRadius="10" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtCardNhomMau" Text="O+" FontSize="15" FontWeight="Black" Foreground="#e11d48"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#33ffffff" Margin="0,0,0,16"/>

                            <!-- Grid Details -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Border Grid.Column="0" Background="#22ffffff" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="CĂN CƯỚC CD:" FontSize="11" FontWeight="Bold" Foreground="#ffe4e6"/>
                                        <TextBlock x:Name="txtCardCCCD" Text="048096001234" FontSize="13" FontWeight="Black" Foreground="White" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#22ffffff" CornerRadius="12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="GIỚI TÍNH / NGÀY SINH:" FontSize="11" FontWeight="Bold" Foreground="#ffe4e6"/>
                                        <TextBlock x:Name="txtCardGioiTinh" Text="Nam | 15/05/1998" FontSize="13" FontWeight="Black" Foreground="White" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Volume Selection -->
                            <Border Background="#22ffffff" CornerRadius="14" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="DỰ KIẾN THỂ TÍCH LẤY MÁU (ML)" FontSize="11" FontWeight="Black" Foreground="#ffe4e6" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnVol250" Grid.Column="0" Content="250 ml" Height="42" Background="White" Foreground="#e11d48" FontWeight="Black" FontSize="13" Cursor="Hand" BorderThickness="0" Click="btnVol_Click"/>
                                        <Button x:Name="btnVol350" Grid.Column="2" Content="350 ml" Height="42" Background="White" Foreground="#e11d48" FontWeight="Black" FontSize="13" Cursor="Hand" BorderThickness="0" Click="btnVol_Click"/>
                                        <Button x:Name="btnVol450" Grid.Column="4" Content="450 ml" Height="42" Background="#33ffffff" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" BorderThickness="0" Click="btnVol_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: 4 Vitals & Approval Panel -->
                <Border Grid.Column="2" Background="White" BorderBrush="#ffe4e6" BorderThickness="1" CornerRadius="18" Padding="24">
                    <StackPanel x:Name="FormKham">
                        <!-- Panel Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🩺 ĐO 4 CHỈ SỐ SINH HIỆU Y TẾ THỰC TẾ" FontSize="16" FontWeight="Black" Foreground="#0f172a"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                <TextBlock Text="Chuẩn Bộ Y Tế" FontSize="11" FontWeight="Black" Foreground="#e11d48"/>
                            </Border>
                        </Grid>

                        <!-- 4 Vitals 2x2 Grid Cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vital 1: Huyết áp -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="1. Huyết Áp (mmHg) *" FontSize="13" FontWeight="Black" Foreground="#0f172a"/>
                                        <TextBlock Text="Chuẩn: 90 - 140" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox x:Name="txtHuyetAp" Height="46" Text="120/80" Padding="12,0" VerticalContentAlignment="Center" 
                                             FontSize="15" FontWeight="Black" Foreground="#0f172a" Background="White" BorderBrush="#cbd5e1" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Vital 2: Nhịp tim -->
                            <Border Grid.Row="0" Grid.Column="2" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="2. Nhịp Tim (lần/phút) *" FontSize="13" FontWeight="Black" Foreground="#0f172a"/>
                                        <TextBlock Text="Chuẩn: 60 - 100" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox x:Name="txtNhipTim" Height="46" Text="75" Padding="12,0" VerticalContentAlignment="Center" 
                                             FontSize="15" FontWeight="Black" Foreground="#0f172a" Background="White" BorderBrush="#cbd5e1" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Vital 3: Cân nặng -->
                            <Border Grid.Row="2" Grid.Column="0" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="3. Cân Nặng (kg) *" FontSize="13" FontWeight="Black" Foreground="#0f172a"/>
                                        <TextBlock Text="Chuẩn: >= 45 kg" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox x:Name="txtCanNang" Height="46" Text="60" Padding="12,0" VerticalContentAlignment="Center" 
                                             FontSize="15" FontWeight="Black" Foreground="#0f172a" Background="White" BorderBrush="#cbd5e1" BorderThickness="1"/>
                                </StackPanel>
                            </Border>

                            <!-- Vital 4: Nhiệt độ -->
                            <Border Grid.Row="2" Grid.Column="2" Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" CornerRadius="14" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="4. Nhiệt Độ (°C) *" FontSize="13" FontWeight="Black" Foreground="#0f172a"/>
                                        <TextBlock Text="Chuẩn: 36.5 - 37.5" FontSize="11" FontWeight="Bold" Foreground="#64748b" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox x:Name="txtNhietDo" Height="46" Text="36.8" Padding="12,0" VerticalContentAlignment="Center" 
                                             FontSize="15" FontWeight="Black" Foreground="#0f172a" Background="White" BorderBrush="#cbd5e1" BorderThickness="1"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Realtime Assessment Banner -->
                        <Border x:Name="AssessmentBadge" Background="#f0fdf4" BorderBrush="#bbf7d0" BorderThickness="1.5" CornerRadius="14" Padding="16,14" Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="ĐÁNH GIÁ SINH HIỆU TỰ ĐỘNG" FontSize="11" FontWeight="Black" Foreground="#15803d" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="txtAssessmentMsg" Text="✅ CÁC CHỈ SỐ SINH HIỆU BÌNH THƯỜNG - ĐỦ ĐIỀU KIỆN SỨC KHỎE" FontSize="14" FontWeight="Black" Foreground="#15803d" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Refusal Reason Input -->
                        <StackPanel x:Name="PanelLyDo" Visibility="Collapsed" Margin="0,0,0,20">
                            <TextBlock Text="Lý do tạm hoãn / từ chối hiến máu *" FontSize="12" FontWeight="Black" Foreground="#e11d48" Margin="0,0,0,8"/>
                            <TextBox x:Name="txtLyDoTuChoi" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="12" 
                                     BorderBrush="#fecdd3" BorderThickness="1.5" Background="#fff1f2" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnTuChoi" Grid.Column="0" Content="❌ Từ Chối Hiến Máu" Height="50" 
                                    Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1.5" Foreground="#e11d48" 
                                    FontWeight="Black" FontSize="14" Cursor="Hand" Click="btnTuChoi_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="btnPheDuyet" Grid.Column="2" Content="✅ Đủ Điều Kiện Hiến Máu" Height="50" 
                                    Background="#e11d48" Foreground="White" FontWeight="Black" FontSize="14" 
                                    Cursor="Hand" BorderThickness="0" Click="btnPheDuyet_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- VIEW 2: LỊCH SỬ KHÁM (Table View) -->
            <StackPanel x:Name="ViewLichSu" Visibility="Collapsed">
                <Border Background="White" BorderBrush="#ffe4e6" BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="📋 LỊCH SỬ ĐÁNH GIÁ SỨC KHỎE LÂM SÀNG ĐÃ THỰC HIỆN" FontSize="14" FontWeight="Black" Foreground="#0f172a" VerticalAlignment="Center"/>
                        <Button x:Name="btnRefreshHistory" Content="LÀM MỚI" Height="40" Width="110" HorizontalAlignment="Right"
                                Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1" Foreground="#e11d48" FontWeight="Black" Cursor="Hand" Click="btnRefreshHistory_Click"/>
                    </Grid>
                </Border>

                <Border CornerRadius="18" Background="White" BorderBrush="#ffe4e6" BorderThickness="1" ClipToBounds="True">
                    <DataGrid x:Name="dgLichSu" Margin="-1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã KQ" Binding="{Binding MaKQ}" Width="110"/>
                            <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="120"/>
                            <DataGridTextColumn Header="Họ và Tên TNV" Binding="{Binding HoTenTNV}" Width="*"/>
                            <DataGridTextColumn Header="Huyết Áp" Binding="{Binding HuyetAp}" Width="120"/>
                            <DataGridTextColumn Header="Nhịp Tim" Binding="{Binding NhipTim, StringFormat={}{0} bpm}" Width="110"/>
                            <DataGridTextColumn Header="Cân Nặng" Binding="{Binding CanNang, StringFormat={}{0} kg}" Width="110"/>
                            <DataGridTextColumn Header="Nhiệt Độ" Binding="{Binding NhietDo, StringFormat={}{0} °C}" Width="110"/>
                            
                            <DataGridTemplateColumn Header="Kết Luận" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KetQuaHienThi}" FontWeight="Black" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803d"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDat}" Value="False">
                                                            <Setter Property="Foreground" Value="#e11d48"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ngày Khám" Binding="{Binding NgayKham, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
