<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng Nhập Hệ Thống Y Tế" Height="500" Width="850"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    
    <Border CornerRadius="20" Background="White" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Banner Đỏ -->
            <Border Grid.Column="0" CornerRadius="20,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#e62e43" Offset="0.0" />
                        <GradientStop Color="#c01b30" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Width="50" Height="50" CornerRadius="10" Background="#33ffffff" HorizontalAlignment="Left">
                        <TextBlock Text="❤" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Chào mừng&#x0a;trở lại!" Foreground="White" FontSize="36" FontWeight="Black" TextWrapping="Wrap" LineHeight="45"/>
                        <TextBlock Text="Hệ thống quản lý hiến máu dành cho Cán bộ nhân viên y tế." Foreground="#dddddd" FontSize="14" TextWrapping="Wrap" Margin="0,15,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#11ffffff" CornerRadius="10" Padding="15">
                        <TextBlock Text="&quot;Mỗi giọt máu cho đi, một cuộc đời ở lại.&quot;" Foreground="White" FontStyle="Italic" TextWrapping="Wrap" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cột phải: Form đăng nhập -->
            <Grid Grid.Column="1" Margin="40,30,40,30">
                <!-- Nút đóng cửa sổ -->
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Width="30" Height="30" Background="Transparent" BorderThickness="0" 
                        FontSize="18" Foreground="#999" Cursor="Hand" Click="btnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đăng Nhập" FontSize="32" FontWeight="Black" Foreground="#222" Margin="0,0,0,5"/>
                    <TextBlock Text="Vui lòng điền thông tin tài khoản của bạn." FontSize="14" Foreground="#777" Margin="0,0,0,30"/>

                    <TextBlock Text="TÀI KHOẢN" FontSize="11" FontWeight="Bold" Foreground="#999" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#e5e5e5" BorderThickness="2" Background="#f8fafc" Margin="0,0,0,20">
                        <TextBox x:Name="txtUsername" Height="45" FontSize="14" Padding="10,12,10,10" 
                                 Background="Transparent" BorderThickness="0" Foreground="#333"
                                 TextChanged="txtUsername_TextChanged"/>
                    </Border>

                    <TextBlock Text="MẬT KHẨU" FontSize="11" FontWeight="Bold" Foreground="#999" Margin="0,0,0,5"/>
                    <Border CornerRadius="8" BorderBrush="#e5e5e5" BorderThickness="2" Background="#f8fafc" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <PasswordBox x:Name="txtPassword" Grid.Column="0" Height="45" FontSize="14" Padding="10,12,10,10" 
                                         Background="Transparent" BorderThickness="0" Foreground="#333"
                                         PasswordChanged="txtPassword_PasswordChanged"/>
                                         
                            <TextBox x:Name="txtPasswordVisible" Grid.Column="0" Height="45" FontSize="14" Padding="10,12,10,10" 
                                     Background="Transparent" BorderThickness="0" Foreground="#333" Visibility="Collapsed"
                                     TextChanged="txtPasswordVisible_TextChanged"/>
                                     
                            <Button x:Name="btnTogglePassword" Grid.Column="1" Content="👁" Width="40" Height="45" 
                                    Background="Transparent" BorderThickness="0" Foreground="#999" FontSize="16"
                                    Cursor="Hand" Click="btnTogglePassword_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Error Message -->
                    <TextBlock x:Name="txtError" Text="Tài khoản hoặc mật khẩu không chính xác!" 
                               Foreground="#e11d48" FontSize="12" Margin="0,0,0,20" 
                               HorizontalAlignment="Center" Visibility="Collapsed" FontWeight="Bold"/>

                    <Button x:Name="btnLogin" Content="ĐĂNG NHẬP" Height="50" 
                            FontSize="14" FontWeight="Black" Foreground="White" Cursor="Hand" Click="btnLogin_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#e62e43" Offset="0.0" />
                                <GradientStop Color="#c01b30" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
