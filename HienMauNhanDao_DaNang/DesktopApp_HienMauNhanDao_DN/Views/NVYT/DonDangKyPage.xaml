<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.DonDangKyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Đơn Đăng Ký" Background="White" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e2e8f0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#f8fafc"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#f1f5f9"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="45"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#f1f5f9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#cbd5e1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#e0f2fe"/>
                    <Setter Property="Foreground" Value="#0369a1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="QUẢN LÝ ĐƠN ĐĂNG KÝ THEO CHIẾN DỊCH &amp; KHU VỰC" FontSize="22" FontWeight="Black" Foreground="#1e293b"/>
            <TextBlock Text="Phân loại đơn đăng ký theo từng đợt hiến máu &amp; phát hiện TNV đi nhầm địa điểm tiếp nhận" FontSize="12" Foreground="#64748b" Margin="0,2,0,0"/>
        </StackPanel>
        
        <!-- Controls & Filters -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <!-- Row 1: Filter Bar -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="📍 Chọn Chiến Dịch:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,10,0"/>
                
                <!-- Campaign Dropdown with Location Info -->
                <ComboBox x:Name="cbChienDichFilter" Grid.Column="1" Height="38" VerticalContentAlignment="Center"
                          DisplayMemberPath="TenChienDich" SelectedValuePath="MaChienDich"
                          SelectionChanged="cbChienDichFilter_SelectionChanged"/>

                <!-- Search Box -->
                <Border Grid.Column="3" CornerRadius="8" BorderBrush="#cbd5e1" BorderThickness="1" Height="38" Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Margin="10,0,5,0" VerticalAlignment="Center" Foreground="#94a3b8"/>
                        <TextBox x:Name="txtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Padding="0,0,10,0" FontSize="13" Foreground="#334155" KeyUp="txtSearch_KeyDown" Tag="Nhập Họ tên, CCCD, Mã đơn..."/>
                    </Grid>
                </Border>

                <!-- Fast CCCD Check Button -->
                <Button x:Name="btnCheckCCCD" Grid.Column="5" Content="🔍 KIỂM TRA" Height="38" Padding="16,0" HorizontalAlignment="Left"
                        Background="#0284c7" BorderThickness="0" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnCheckCCCD_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <!-- Refresh Button -->
                <Button x:Name="btnRefresh" Grid.Column="7" Content="🔄 LÀM MỚI" Height="38" Width="95" 
                        Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" Foreground="#475569"
                        FontWeight="Bold" Cursor="Hand" Click="btnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Walk-in Button -->
                <Button x:Name="btnWalkIn" Grid.Column="9" Content="+ TIẾP NHẬN TRỰC TIẾP (WALK-IN)" Height="38" Padding="14,0" 
                        Background="#dc2626" BorderThickness="0" Foreground="White"
                        FontWeight="Bold" Cursor="Hand" Click="btnWalkIn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 2: Selected Campaign Location Banner -->
            <Border x:Name="pnlCampaignInfo" Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🏥 KHU VỰC TỔ CHỨC HIỆN TẠI: " FontWeight="Black" Foreground="#0369a1" FontSize="13"/>
                    <TextBlock x:Name="txtCampaignLocation" Text="Tất cả các chiến dịch trên địa bàn TP. Đà Nẵng" FontWeight="Bold" Foreground="#0284c7" FontSize="13" Margin="5,0,20,0"/>
                    <TextBlock x:Name="txtCampaignStats" Text="📊 Tổng đơn: 0 | ⚡ Đã đăng ký: 0 | ✅ Đã tiếp nhận: 0" FontWeight="SemiBold" Foreground="#475569" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>


        <!-- DataGrid -->
        <Border Grid.Row="2" CornerRadius="10" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgDonDangKy" Margin="-1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="95"/>
                    <DataGridTextColumn Header="Người Hiến Máu" Binding="{Binding HoTenTNV}" Width="150"/>
                    <DataGridTextColumn Header="Số CCCD" Binding="{Binding CccdTNV}" Width="125"/>
                    <DataGridTextColumn Header="Chiến Dịch / Địa Điểm" Binding="{Binding TenChienDich}" Width="*"/>

                    <DataGridTextColumn Header="Thể Tích" Binding="{Binding TheTich, StringFormat={}{0} ml}" Width="100"/>
                    <DataGridTextColumn Header="Ngày Đăng Ký" Binding="{Binding ThoiGianDangKy, StringFormat=dd/MM/yyyy HH:mm}" Width="150"/>
                    
                    <DataGridTemplateColumn Header="Trạng Thái" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#fef08a"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaDangKy">
                                                    <Setter Property="Background" Value="#e0e7ff"/> <!-- DaDangKy: Indigo -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="ChoDuyet">
                                                    <Setter Property="Background" Value="#fef08a"/> <!-- ChoDuyet: Yellow -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaDuyet">
                                                    <Setter Property="Background" Value="#bbf7d0"/> <!-- DaDuyet: Green -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaHoanThanh">
                                                    <Setter Property="Background" Value="#86efac"/> <!-- DaHoanThanh: Emerald -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaHien">
                                                    <Setter Property="Background" Value="#86efac"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaHuy">
                                                    <Setter Property="Background" Value="#fecaca"/> <!-- DaHuy: Red -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="DaTuChoi">
                                                    <Setter Property="Background" Value="#fca5a5"/> <!-- DaTuChoi: Red -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TrangThaiHienThi}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#854d0e"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaDangKy">
                                                        <Setter Property="Foreground" Value="#3730a3"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="ChoDuyet">
                                                        <Setter Property="Foreground" Value="#a16207"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaDuyet">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaHoanThanh">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaHien">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaHuy">
                                                        <Setter Property="Foreground" Value="#991b1b"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="DaTuChoi">
                                                        <Setter Property="Foreground" Value="#991b1b"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao Tác" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Tiếp Nhận" Width="80" Height="28" Background="#059669" Foreground="White" 
                                        BorderThickness="0" Cursor="Hand" Click="btnTiepNhan_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
