<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.EditHoSoSucKhoeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa Khai Báo Y Tế" Height="480" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#f8fafc">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="SỬA KHAI BÁO Y TẾ" FontSize="18" FontWeight="Black" Foreground="#1e293b"/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Mã Hồ Sơ: " FontSize="12" Foreground="#64748b"/>
                <TextBlock x:Name="txtMaHoSo" FontWeight="Bold" Foreground="#0369a1" FontSize="14" Margin="0,0,15,0"/>
                <TextBlock Text="Mã Đơn: " FontSize="12" Foreground="#64748b"/>
                <TextBlock x:Name="txtMaDon" FontWeight="Bold" Foreground="#334155" FontSize="14"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Sốt/Đau họng?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbQ1_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q1"/>
                    <RadioButton x:Name="rbQ1_No" Content="Không" Grid.Column="2" GroupName="Q1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Kháng sinh?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbQ2_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q2"/>
                    <RadioButton x:Name="rbQ2_No" Content="Không" Grid.Column="2" GroupName="Q2"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Bệnh truyền nhiễm?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbQ3_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q3"/>
                    <RadioButton x:Name="rbQ3_No" Content="Không" Grid.Column="2" GroupName="Q3"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Thai sản (Đối với nữ)?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbQ4_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q4"/>
                    <RadioButton x:Name="rbQ4_No" Content="Không" Grid.Column="2" GroupName="Q4"/>
                </Grid>

                <TextBlock Text="Mô tả khác" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMoTaKhac" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" BorderBrush="#cbd5e1" BorderThickness="1"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Hủy" Height="40" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Foreground="#475569" FontWeight="Bold" Cursor="Hand" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Grid.Column="2" Content="Lưu Thay Đổi" Height="40" Background="#dc2626" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>
