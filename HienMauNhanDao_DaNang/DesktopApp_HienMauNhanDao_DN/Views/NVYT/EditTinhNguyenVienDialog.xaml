<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.EditTinhNguyenVienDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cập Nhật Tình Nguyện Viên" Height="450" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#f8fafc">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="CẬP NHẬT TÌNH NGUYỆN VIÊN" FontSize="18" FontWeight="Black" Foreground="#1e293b"/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Mã TNV: " FontSize="12" Foreground="#64748b"/>
                <TextBlock x:Name="txtMaTNV" FontWeight="Bold" Foreground="#0369a1" FontSize="14" Margin="0,0,0,5"/>
                <TextBlock Text="CCCD: " FontSize="12" Foreground="#64748b"/>
                <TextBlock x:Name="txtCCCD" FontWeight="Bold" Foreground="#334155" FontSize="14"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Họ và Tên" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtHoTen" Height="35" Padding="10,0" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ngày Sinh" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpNgaySinh" Height="35"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Giới Tính" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbGioiTinh" Height="35">
                        <ComboBoxItem Content="Nam"/>
                        <ComboBoxItem Content="Nữ"/>
                        <ComboBoxItem Content="Khác"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Số Điện Thoại" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtSDT" Height="35" Padding="10,0" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

            <TextBlock Text="Địa Chỉ" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDiaChi" Height="35" Padding="10,0" BorderBrush="#cbd5e1" BorderThickness="1" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Hủy" Height="40" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Foreground="#475569" FontWeight="Bold" Cursor="Hand" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Grid.Column="2" Content="Lưu Thay Đổi" Height="40" Background="#dc2626" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>
