<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.NVYTDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Điều Khiển Nhân Viên Y Tế" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Style cho Menu Button -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1e293b">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,40,0,30">
                    <Border Width="64" Height="64" Background="#e62e43" CornerRadius="32" Margin="0,0,0,15">
                        <TextBlock Text="❤" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="HỆ THỐNG Y TẾ" Foreground="White" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Cổng Nhân Viên" Foreground="#94a3b8" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Menu Items -->
                <StackPanel Grid.Row="1" Margin="15,0">
                    <Button x:Name="btnDonDangKy" Content="Quản Lý Đơn Đăng Ký" Style="{StaticResource MenuButtonStyle}" Click="btnDonDangKy_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnTinhNguyenVien" Content="Tình Nguyện Viên" Style="{StaticResource MenuButtonStyle}" Click="btnTinhNguyenVien_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnKhaiBaoYTe" Content="Duyệt Khai Báo Y Tế" Style="{StaticResource MenuButtonStyle}" Click="btnKhaiBaoYTe_Click" Visibility="Collapsed"/>
                    
                    <Button x:Name="btnThuNhanMau" Content="Thu Nhận Máu" Style="{StaticResource MenuButtonStyle}" Click="btnThuNhanMau_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnCapNhatXetNghiem" Content="Cập Nhật Xét Nghiệm" Style="{StaticResource MenuButtonStyle}" Click="btnCapNhatXetNghiem_Click" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Footer (Logout) -->
                <Button x:Name="btnLogout" Grid.Row="2" Content="ĐĂNG XUẤT" Margin="20,20,20,30" Height="45"
                        Foreground="#fca5a5" FontWeight="Bold" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="btnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="#fca5a5" BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#450a0a"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="#f8fafc">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
