<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.NVYTDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Điều Khiển Nhân Viên Y Tế" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#fdf8f9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Menu -->
        <Border Grid.Column="0" Background="#ffffff" BorderBrush="#e5e5e5" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="CỔNG Y TẾ" FontSize="20" FontWeight="Bold" Foreground="#e62e43" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                <Button x:Name="btnDonDangKy" Content="Quản Lý Đơn Đăng Ký" Height="50" FontSize="15" Margin="10,5" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                <Button x:Name="btnKhaiBaoYTe" Content="Duyệt Khai Báo Y Tế" Height="50" FontSize="15" Margin="10,5" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                <Button x:Name="btnThuNhanMau" Content="Thu Nhận Máu" Height="50" FontSize="15" Margin="10,5" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                <Button x:Name="btnCapNhatXetNghiem" Content="Cập Nhật Xét Nghiệm" Height="50" FontSize="15" Margin="10,5" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left" Padding="20,0,0,0"/>
                
                <Button x:Name="btnLogout" Content="Đăng Xuất" Height="50" FontSize="15" Margin="10,50,10,5" Background="#ffeeef" Foreground="#e62e43" BorderThickness="0" Cursor="Hand" Click="btnLogout_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
