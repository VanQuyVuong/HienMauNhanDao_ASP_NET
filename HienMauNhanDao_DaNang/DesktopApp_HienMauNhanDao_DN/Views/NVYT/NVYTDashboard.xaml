<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.NVYTDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảng Điều Khiển Nhân Viên Y Tế" Height="768" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow">
    
    <Window.Resources>
        <!-- Style cho Menu Button -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Active"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#be123c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="Inactive"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#fff1f2"/>
                                <Setter Property="Foreground" Value="#e11d48"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Brand Card -->
                <Border Grid.Row="0" Margin="15,20,15,25" CornerRadius="16" Padding="15,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#e11d48" Offset="0.0"/>
                            <GradientStop Color="#9f1239" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Width="50" Height="50" Background="#33ffffff" CornerRadius="25" Margin="0,0,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="🩸" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="HIẾN MÁU NHÂN ĐẠO" Foreground="#ffe4e6" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="BẢNG ĐIỀU KHIỂN" Foreground="White" FontSize="16" FontWeight="Black" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Menu Items -->
                <StackPanel Grid.Row="1" Margin="15,0">
                    <Button x:Name="btnDonDangKy" Content="📋  Quản Lý Đơn Đăng Ký" Style="{StaticResource MenuButtonStyle}" Click="btnDonDangKy_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnTinhNguyenVien" Content="👥  Tình Nguyện Viên" Style="{StaticResource MenuButtonStyle}" Click="btnTinhNguyenVien_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnKhaiBaoYTe" Content="📑  Duyệt Khai Báo Y Tế" Style="{StaticResource MenuButtonStyle}" Click="btnKhaiBaoYTe_Click" Visibility="Collapsed"/>
                    
                    <Button x:Name="btnThuNhanMau" Content="💉  Thu Nhận Máu" Style="{StaticResource MenuButtonStyle}" Click="btnThuNhanMau_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnCapNhatXetNghiem" Content="🔬  Cập Nhật Xét Nghiệm" Style="{StaticResource MenuButtonStyle}" Click="btnCapNhatXetNghiem_Click" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Footer (Logout) -->
                <Button x:Name="btnLogout" Grid.Row="2" Content="🚪 ĐĂNG XUẤT" Margin="15,20,15,25" Height="44"
                        Foreground="White" FontWeight="Bold" FontSize="13" Background="#b91c1c" BorderThickness="0" Cursor="Hand" Click="btnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#b91c1c" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Border Grid.Column="1" Background="#f8fafc">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Border>
    </Grid>
</Window>
