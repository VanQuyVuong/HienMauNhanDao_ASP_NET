<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.NVYT.TiepNhanQuayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tiếp Nhận Tại Quầy" Height="500" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#f8fafc">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="TIẾP NHẬN TẠI QUẦY &amp; KIỂM TRA SƠ LƯỢC" FontSize="16" FontWeight="Black" Foreground="#059669"/>
            <TextBlock Text="Xác nhận TNV có mặt tại quầy lễ tân &amp; chuyển Bác sĩ" FontSize="12" Foreground="#64748b"/>
        </StackPanel>
        
        <Border Grid.Row="1" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock x:Name="txtMaDon" FontSize="12" FontWeight="Bold" Foreground="#94a3b8" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Họ và tên TNV:" FontSize="12" Foreground="#64748b"/>
                        <TextBlock x:Name="txtHoTen" FontWeight="Bold" FontSize="14" Foreground="#1e293b"/>
                        <TextBlock Text="Số điện thoại:" FontSize="12" Foreground="#64748b" Margin="0,10,0,0"/>
                        <TextBlock x:Name="txtSDT" FontWeight="Bold" FontSize="14" Foreground="#334155"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Số CCCD:" FontSize="12" Foreground="#64748b"/>
                        <TextBlock x:Name="txtCCCD" FontWeight="Bold" FontSize="14" Foreground="#334155"/>
                        <TextBlock Text="Thể tích hiến:" FontSize="12" Foreground="#64748b" Margin="0,10,0,0"/>
                        <ComboBox x:Name="cbTheTich" Height="25" Margin="0,2,20,0">
                            <ComboBoxItem Content="250 ml"/>
                            <ComboBoxItem Content="350 ml" IsSelected="True"/>
                            <ComboBoxItem Content="450 ml"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Hỏi sơ lược tình trạng sức khỏe hôm nay:" FontWeight="Bold" Foreground="#1e293b" Margin="0,0,0,10"/>
                
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="1. Đã từng hiến máu?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbDaTungHien_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q1"/>
                    <RadioButton x:Name="rbDaTungHien_No" Content="Không" Grid.Column="2" IsChecked="True" GroupName="Q1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="2. Xăm hình/Tiêm vắc xin/Phẫu thuật?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbXamHinh_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q2"/>
                    <RadioButton x:Name="rbXamHinh_No" Content="Không" Grid.Column="2" IsChecked="True" GroupName="Q2"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="3. Uống rượu bia/Thức khuya?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbRuouBia_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q3"/>
                    <RadioButton x:Name="rbRuouBia_No" Content="Không" Grid.Column="2" IsChecked="True" GroupName="Q3"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="4. Bệnh mạn tính?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbManTinh_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q4"/>
                    <RadioButton x:Name="rbManTinh_No" Content="Không" Grid.Column="2" IsChecked="True" GroupName="Q4"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="5. Nữ: Mang thai/kinh nguyệt/cho con bú?" VerticalAlignment="Center"/>
                    <RadioButton x:Name="rbCoThai_Yes" Content="Có" Grid.Column="1" Margin="10,0" GroupName="Q5"/>
                    <RadioButton x:Name="rbCoThai_No" Content="Không" Grid.Column="2" IsChecked="True" GroupName="Q5"/>
                </Grid>

                <TextBlock Text="Ghi chú sức khỏe (nếu có)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtMoTaKhac" Height="30" Padding="5" BorderBrush="#cbd5e1" BorderThickness="1"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnCancel" Grid.Column="0" Content="Hủy" Height="40" Background="White" BorderBrush="#cbd5e1" BorderThickness="1" Foreground="#475569" FontWeight="Bold" Cursor="Hand" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Grid.Column="2" Content="Xác Nhận Tiếp Nhận" Height="40" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="btnSave_Click"/>
        </Grid>
    </Grid>
</Window>
