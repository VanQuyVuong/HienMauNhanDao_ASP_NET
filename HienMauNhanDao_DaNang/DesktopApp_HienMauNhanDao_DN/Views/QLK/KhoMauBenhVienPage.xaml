<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.QLK.KhoMauBenhVienPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Kho Bệnh Viện &amp; Quét Mã" Background="#f8fafc" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ffedd5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fff7ed"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ffedd5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="52"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#fff7ed"/>
            <Setter Property="Foreground" Value="#c2410c"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#fed7aa"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#f8fafc">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Compact Header Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ea580c" Offset="0.0"/>
                    <GradientStop Color="#f97316" Offset="0.5"/>
                    <GradientStop Color="#e11d48" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="KHO MÁU LƯU TRỮ BỆNH VIỆN &amp; TRẠM QUÉT MÃ" Foreground="White" FontSize="16" FontWeight="Black"/>
                    <TextBlock x:Name="txtHospitalHeader" Text="Quét mã vạch túi máu, 1-Click nhập kho hoặc gửi yêu cầu Re-Test vi sinh sang NVYT Xét Nghiệm" 
                               Foreground="#ffedd5" FontSize="11" FontWeight="Medium" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#33ffffff" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="📦 THỦ KHO BỆNH VIỆN" Foreground="White" FontSize="10" FontWeight="Black"/>
                </Border>
            </Grid>
        </Border>

        <!-- Compact 8 Blood Type Storage Cards Grid -->
        <Border Grid.Row="1" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="KHO LƯU TRỮ 8 NHÓM MÁU BỆNH VIỆN" FontSize="10" FontWeight="Black" Foreground="#c2410c" Margin="0,0,0,6"/>
                
                <ItemsControl x:Name="icInventoryCards" Grid.Row="1">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#ea580c" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding NhomMauString}" Foreground="White" FontWeight="Black" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SoLuongTon, StringFormat={}{0} túi}" Foreground="#0f172a" FontWeight="Black" FontSize="12"/>
                                        <TextBlock Text="{Binding TinhTrangHienThi}" Foreground="{Binding TinhTrangFg}" FontWeight="Bold" FontSize="9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Compact Realtime Scan Barcode Station -->
        <Border Grid.Row="2" Background="#0f172a" CornerRadius="14" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Input Scan Form -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtScanBarcode" Grid.Column="0" Height="36" Padding="12,0" 
                             Background="#1e293b" Foreground="#f8fafc" BorderBrush="#ea580c" BorderThickness="1.5" 
                             VerticalContentAlignment="Center" FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                             KeyDown="txtScanBarcode_KeyDown" Tag="🔍 Nhập hoặc quét mã vạch túi máu (VD: TM00024)..."/>

                    <Button x:Name="btnScan" Grid.Column="2" Content="⚡ QUÉT MÁ" Height="36" 
                            Background="#ea580c" Foreground="White" FontWeight="Black" FontSize="11" Cursor="Hand" Click="btnScan_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Scan Result Live Preview Card -->
                <Border x:Name="ScanResultCard" Grid.Row="1" Background="#1e293b" BorderBrush="#ea580c" BorderThickness="1.5" CornerRadius="14" Padding="16" Visibility="Collapsed" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="#ea580c" Padding="10,3" CornerRadius="6" Margin="0,0,10,0">
                                    <TextBlock x:Name="txtScanMaTui" Text="TM0412850" Foreground="White" FontWeight="Black" FontSize="14" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock x:Name="txtScanNhomMau" Text="O+" Foreground="#f97316" FontWeight="Black" FontSize="15" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtScanTheTich" Text=" • 350 ml" Foreground="#94a3b8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtScanDonor" Text="TNV: Nguyễn Văn A | CCCD: 048096001234" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="txtScanViSinh" Text="✅ ĐẠT TIÊU CHUẨN VI SINH" Foreground="#34d399" FontWeight="Black" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnConfirmImport" Content="✅ DUYỆT NHẬP KHO" Height="40" Padding="16,0" Margin="0,0,10,0"
                                    Background="#16a34a" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnConfirmImport_Click"/>
                            <Button x:Name="btnReportIssue" Content="⚠️ BÁO SỰ CỐ / RE-TEST" Height="40" Padding="14,0"
                                    Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnReportIssue_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Search Toolbar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="40" Padding="14,0" BorderBrush="#fed7aa" BorderThickness="1.5" 
                         VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" 
                         TextChanged="txtSearch_TextChanged" Tag="🔍 Tìm theo mã túi, mã đơn, họ tên TNV..."/>

                <ComboBox x:Name="cbFilterStatus" Grid.Column="2" Height="40" VerticalContentAlignment="Center" 
                          FontSize="12" FontWeight="Black" Foreground="#0f172a" SelectionChanged="cbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Tất cả túi máu" IsSelected="True" Tag="ALL"/>
                    <ComboBoxItem Content="Đã lưu kho bệnh viện" Tag="DaLuuKho"/>
                    <ComboBoxItem Content="Chờ xử lý / Re-test" Tag="ChuaXuLy"/>
                </ComboBox>

                <Button x:Name="btnRefresh" Grid.Column="4" Content="LÀM MỚI" Height="40" 
                        Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Foreground="#c2410c" 
                        FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main DataGrid -->
        <Border Grid.Row="4" CornerRadius="18" Background="White" BorderBrush="#ffedd5" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgBloodUnits" Margin="-1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Mã Túi Máu" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Padding="10,4" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MaTuiMau}" Foreground="#c2410c" FontWeight="Black" FontSize="13" FontFamily="Consolas"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="110"/>
                    <DataGridTextColumn Header="Họ và Tên TNV" Binding="{Binding TenTinhNguyenVien}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="Nhóm Máu" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#ea580c" Padding="12,4" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NhomMau}" Foreground="White" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Thể Tích" Binding="{Binding TheTich, StringFormat={}{0} ml}" Width="100"/>
                    <DataGridTextColumn Header="Thời Gian Lấy" Binding="{Binding ThoiGianLay}" Width="150"/>
                    <DataGridTextColumn Header="Ngày Hết Hạn" Binding="{Binding NgayHetHan}" Width="130"/>

                    <DataGridTemplateColumn Header="Trạng Thái Kho" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#dcfce7" BorderBrush="#86efac" BorderThickness="1" Padding="10,4" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrangThaiHienThi}" Foreground="#15803d" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- REPORT ISSUE MODAL -->
        <Grid x:Name="IssueModal" Grid.RowSpan="5" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="#0f172a" CornerRadius="28" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="20">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#dc2626" Padding="24,20" CornerRadius="28,28,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="⚠️ BÁO SỰ CỐ / YÊU CẦU RE-TEST" Foreground="White" FontSize="16" FontWeight="Black"/>
                                <TextBlock Text="Gửi yêu cầu kiểm tra xét nghiệm lại hoặc báo hủy túi máu bị lỗi" Foreground="#fee2e2" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="btnCloseModal_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="24">
                        <TextBlock Text="LÝ DO CHI TIẾT TỪ CHỐI / CẦN KIỂM TRA *" FontSize="12" FontWeight="Black" Foreground="#cbd5e1" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtIssueReason" Height="80" TextWrapping="Wrap" Padding="12,8" 
                                 Background="#020617" Foreground="White" BorderBrush="#334155" BorderThickness="1" FontSize="13" Margin="0,0,0,20"/>

                        <!-- Action buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="🔄 RE-TEST XÉT NGHIỆM" Height="44" Background="#ea580c" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitReTest_Click"/>
                            <Button Grid.Column="2" Content="❌ HUỶ TÚI MÁU HỎNG" Height="44" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnSubmitCancelBag_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
