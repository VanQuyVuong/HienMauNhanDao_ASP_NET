<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.QLK.NhapKhoChienDichPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Nhập Kho Theo Chiến Dịch" Background="#f8fafc" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ffedd5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fff7ed"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ffedd5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="52"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#fff7ed"/>
            <Setter Property="Foreground" Value="#c2410c"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#fed7aa"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#f8fafc">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Compact Header Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ea580c" Offset="0.0"/>
                    <GradientStop Color="#f97316" Offset="0.5"/>
                    <GradientStop Color="#e11d48" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NHẬP KHO TÚI MÁU THEO ĐỢT HIẾN CHIẾN DỊCH" Foreground="White" FontSize="16" FontWeight="Black"/>
                    <TextBlock Text="Quản lý và nhập danh sách túi máu thu được từ các đợt hiến máu nhân đạo lưu động" 
                               Foreground="#ffedd5" FontSize="11" FontWeight="Medium" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#33ffffff" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="📋 THỦ KHO BỆNH VIỆN" Foreground="White" FontSize="10" FontWeight="Black"/>
                </Border>
            </Grid>
        </Border>

        <!-- Fixed Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="40" Padding="14,0" BorderBrush="#fed7aa" BorderThickness="1.5" 
                         VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" 
                         TextChanged="txtSearch_TextChanged" Tag="🔍 Tìm theo tên đợt hiến, địa điểm tổ chức..."/>

                <Button x:Name="btnRefresh" Grid.Column="2" Content="LÀM MỚI" Height="40" 
                        Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Foreground="#c2410c" 
                        FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main DataGrid Campaigns -->
        <Border Grid.Row="2" CornerRadius="18" Background="White" BorderBrush="#ffedd5" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgCampaigns" Margin="-1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đợt" Binding="{Binding MaChienDich}" Width="120"/>
                    <DataGridTextColumn Header="Tên Chiến Dịch Hiến Máu" Binding="{Binding TenChienDich}" Width="*"/>
                    <DataGridTextColumn Header="Địa Điểm Tổ Chức" Binding="{Binding DiaDiem}" Width="200"/>
                    <DataGridTextColumn Header="Thời Gian Tổ Chức" Binding="{Binding ThoiGianHienThi}" Width="180"/>
                    <DataGridTextColumn Header="Chỉ Tiêu (Túi)" Binding="{Binding SoLuongDuKien, StringFormat={}{0} túi}" Width="120"/>

                    <DataGridTemplateColumn Header="Trạng Thái" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#dcfce7" BorderBrush="#86efac" BorderThickness="1" Padding="10,4" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrangThaiHienThi}" Foreground="#15803d" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao Tác" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🔍 Xem Túi Máu" Height="36" Padding="14,0" 
                                        Background="#ea580c" Foreground="White" FontWeight="Black" FontSize="12" 
                                        Cursor="Hand" BorderThickness="0" Click="btnViewBags_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BAGS DETAIL MODAL -->
        <Grid x:Name="BagsModal" Grid.RowSpan="3" Background="#aa0f172a" Visibility="Collapsed">
            <Border Background="#0f172a" CornerRadius="28" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Margin="20">
                <StackPanel>
                    <Border Background="#ea580c" Padding="24,20" CornerRadius="28,28,0,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="txtModalTitle" Text="📋 CHI TIẾT TÚI MÁU THEO ĐỢT HIẾN" Foreground="White" FontSize="16" FontWeight="Black"/>
                                <TextBlock x:Name="txtModalSubtitle" Text="Danh sách các túi máu thu nhận được từ chiến dịch này" Foreground="#ffedd5" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Content="✕" Foreground="White" Background="Transparent" BorderThickness="0" FontSize="20" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" Click="btnCloseModal_Click"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="24">
                        <Border Background="#1e293b" CornerRadius="16" Padding="12" Height="320">
                            <DataGrid x:Name="dgModalBags" Margin="0" Background="Transparent" RowHeight="45">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Túi Máu" Binding="{Binding MaTuiMau}" Width="130"/>
                                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding MaDon}" Width="100"/>
                                    <DataGridTextColumn Header="TNV" Binding="{Binding TenTinhNguyenVien}" Width="*"/>
                                    <DataGridTextColumn Header="Nhóm Máu" Binding="{Binding NhomMau}" Width="100"/>
                                    <DataGridTextColumn Header="Thể Tích" Binding="{Binding TheTich, StringFormat={}{0} ml}" Width="90"/>
                                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding TrangThaiHienThi}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Button Content="ĐÓNG CỬA SỔ" Height="44" Margin="0,16,0,0" Background="#334155" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="btnCloseModal_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
