<Window x:Class="DesktopApp_HienMauNhanDao_DN.Views.QLK.QLKDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Kho Máu - Bệnh Viện C Đà Nẵng" 
        Height="840" Width="1380"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#f8fafc">

    <Window.Resources>
        <Style TargetType="Button" x:Key="SidebarNavButtonStyle">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1e293b"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="border" Property="Background" Value="#dc2626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR NAVIGATION PANEL -->
        <Border Grid.Column="0" Background="#0f172a" BorderBrush="#1e293b" BorderThickness="0,0,1,0">
            <Grid Margin="16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <Border Background="#ea580c" CornerRadius="16" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="📦" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="QUẢN LÝ KHO MÁU" FontSize="18" FontWeight="Black" Foreground="#0f172a"/>
                    <TextBlock Text="TP. ĐÀ NẴNG • QUẢN LÝ KHO" FontSize="10" FontWeight="Black" Foreground="#ea580c" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- User Profile Card -->
                <Border Grid.Row="1" Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12" Background="#ea580c" Margin="0,0,10,0">
                            <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtUserName" Text="Cán Bộ Quản Lý Kho" FontSize="13" FontWeight="Black" Foreground="#0f172a"/>
                            <TextBlock Text="Thủ Kho Bệnh Viện" FontSize="11" Foreground="#c2410c" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4 Navigation Buttons -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="CHỨC NĂNG THỦ KHO" FontSize="10" FontWeight="Black" Foreground="#94a3b8" Margin="8,0,0,12"/>

                    <Button x:Name="btnThongKe" Content="📊  Thống Kê Tồn Kho" Style="{StaticResource SidebarNavButtonStyle}" Click="btnThongKe_Click"/>
                    <Button x:Name="btnPhieuNhapXuat" Content="📜  Phiếu Nhập - Xuất Kho" Style="{StaticResource SidebarNavButtonStyle}" Click="btnPhieuNhapXuat_Click"/>
                    <Button x:Name="btnKhoBenhVien" Content="📦  Kho Bệnh Viện &amp; Quét Mã" Style="{StaticResource SidebarNavButtonStyle}" Click="btnKhoBenhVien_Click"/>
                    <Button x:Name="btnNhapKhoChienDich" Content="📋  Nhập Kho Chiến Dịch" Style="{StaticResource SidebarNavButtonStyle}" Click="btnNhapKhoChienDich_Click"/>
                    <Button x:Name="btnQuanLyHanDung" Content="⏳  Quản Lý Hạn Dùng" Style="{StaticResource SidebarNavButtonStyle}" Click="btnQuanLyHanDung_Click"/>

                </StackPanel>

                <!-- Logout Button -->
                <Button Grid.Row="3" Content="🚪  Đăng Xuất Hệ Thống" Height="46" Background="#fff1f2" Foreground="#e11d48" FontWeight="Black" FontSize="12" Cursor="Hand" BorderThickness="0" Click="btnLogout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN PAGE HOST CONTENT -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
