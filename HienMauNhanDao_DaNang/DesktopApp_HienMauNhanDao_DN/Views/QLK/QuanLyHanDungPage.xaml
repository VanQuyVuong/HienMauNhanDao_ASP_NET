<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.QLK.QuanLyHanDungPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản Lý Hạn Dùng" Background="#f8fafc" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ffedd5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fff7ed"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ffedd5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="52"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#fff7ed"/>
            <Setter Property="Foreground" Value="#c2410c"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#fed7aa"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#f8fafc">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Compact Header Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="16,10" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ea580c" Offset="0.0"/>
                    <GradientStop Color="#f97316" Offset="0.5"/>
                    <GradientStop Color="#e11d48" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="QUẢN LÝ HẠN DÙNG TÚI MÁU &amp; CẢNH BÁO TIÊU HỦY" Foreground="White" FontSize="16" FontWeight="Black"/>
                    <TextBlock Text="Kiểm soát thời hạn 365 ngày lưu trữ túi máu, ưu tiên xuất cấp cứu ca sắp hết hạn và hủy ca quá hạn" 
                               Foreground="#ffedd5" FontSize="11" FontWeight="Medium" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#33ffffff" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="⏳ THỦ KHO BỆNH VIỆN" Foreground="White" FontSize="10" FontWeight="Black"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3 Metric KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: An toàn -->
            <Border Grid.Column="0" Background="White" BorderBrush="#86efac" BorderThickness="1.5" CornerRadius="16" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="HẠN DÙNG AN TOÀN (> 30 NGÀY)" FontSize="11" FontWeight="Black" Foreground="#15803d"/>
                        <TextBlock x:Name="txtKpiSafe" Text="0" FontSize="24" FontWeight="Black" Foreground="#15803d" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#dcfce7" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 2: Sắp hết hạn -->
            <Border Grid.Column="2" Background="White" BorderBrush="#fed7aa" BorderThickness="1.5" CornerRadius="16" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="SẮP HẾT HẠN (&lt;= 30 NGÀY)" FontSize="11" FontWeight="Black" Foreground="#c2410c"/>
                        <TextBlock x:Name="txtKpiNear" Text="0" FontSize="24" FontWeight="Black" Foreground="#c2410c" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#fff7ed" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 3: Quá hạn -->
            <Border Grid.Column="4" Background="White" BorderBrush="#fca5a5" BorderThickness="1.5" CornerRadius="16" Padding="18,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ĐÃ HẾT HẠN (> 365 NGÀY)" FontSize="11" FontWeight="Black" Foreground="#b91c1c"/>
                        <TextBlock x:Name="txtKpiExpired" Text="0" FontSize="24" FontWeight="Black" Foreground="#b91c1c" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Background="#fee2e2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🚨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Fixed Toolbar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="40" Padding="14,0" BorderBrush="#fed7aa" BorderThickness="1.5" 
                         VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" 
                         TextChanged="txtSearch_TextChanged" Tag="🔍 Tìm theo mã túi máu, tên TNV, nhóm máu..."/>

                <ComboBox x:Name="cbFilterExpiry" Grid.Column="2" Height="40" VerticalContentAlignment="Center" 
                          FontSize="12" FontWeight="Black" Foreground="#0f172a" SelectionChanged="cbFilterExpiry_SelectionChanged">
                    <ComboBoxItem Content="Tất cả hạn dùng" IsSelected="True" Tag="all"/>
                    <ComboBoxItem Content="An toàn (> 30 ngày)" Tag="safe"/>
                    <ComboBoxItem Content="Sắp hết hạn (&lt;= 30 ngày)" Tag="near"/>
                    <ComboBoxItem Content="Đã hết hạn" Tag="expired"/>
                </ComboBox>

                <Button x:Name="btnRefresh" Grid.Column="4" Content="LÀM MỚI" Height="40" 
                        Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Foreground="#c2410c" 
                        FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main DataGrid -->
        <Border Grid.Row="3" CornerRadius="18" Background="White" BorderBrush="#ffedd5" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgExpiryUnits" Margin="-1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Mã Túi Máu" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Padding="10,4" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MaTuiMau}" Foreground="#c2410c" FontWeight="Black" FontSize="13" FontFamily="Consolas"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Họ và Tên TNV" Binding="{Binding TenTinhNguyenVien}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="Nhóm Máu" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#ea580c" Padding="12,4" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NhomMau}" Foreground="White" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Thể Tích" Binding="{Binding TheTich, StringFormat={}{0} ml}" Width="100"/>
                    <DataGridTextColumn Header="Thời Gian Lấy" Binding="{Binding ThoiGianLay}" Width="150"/>
                    <DataGridTextColumn Header="Ngày Hết Hạn" Binding="{Binding NgayHetHan}" Width="140"/>

                    <DataGridTemplateColumn Header="Trạng Thái Kho" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#dcfce7" BorderBrush="#86efac" BorderThickness="1" Padding="10,4" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TrangThaiHienThi}" Foreground="#15803d" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
