<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.QLK.ThongKeTonKhoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Thống Kê Tồn Kho" Background="#f8fafc" Loaded="Page_Loaded">

    <Page.Resources>
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ffedd5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#fff7ed"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ffedd5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="52"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#fff7ed"/>
            <Setter Property="Foreground" Value="#c2410c"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#fed7aa"/>
        </Style>
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 2: 2 Visual Charts (Bar Chart 12 Months + Blood Group Donut Allocation) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart 1: Bar Chart 12 Months -->
            <Border Grid.Column="0" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="18" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="140"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="📊 XU HƯỚNG THU NHẬN MÁU THEO THÁNG NĂM 2026" FontSize="11" FontWeight="Black" Foreground="#ea580c"/>
                        <TextBlock Text="Số lượng túi máu tiếp nhận hàng tháng tại TP. Đà Nẵng" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Dynamic Bar Chart Container -->
                    <UniformGrid x:Name="ugBarChart" Grid.Row="1" Columns="12" VerticalAlignment="Bottom" Height="130">
                        <!-- Bars dynamically populated in C# -->
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Chart 2: Blood Type Distribution -->
            <Border Grid.Column="2" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="18" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🍩 PHÂN BỔ 4 NHÓM MÁU CHÍNH" FontSize="11" FontWeight="Black" Foreground="#ea580c"/>
                        <TextBlock Text="Tỷ lệ cơ cấu nhóm máu O, A, B, AB" FontSize="11" Foreground="#64748b" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="spPieChart" Grid.Row="1" VerticalAlignment="Center">
                        <!-- Legend & Percent Bars populated in C# -->
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Fixed Header Banner -->
        <Border Grid.Row="0" CornerRadius="22" Padding="28,20" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#ea580c" Offset="0.0"/>
                    <GradientStop Color="#f97316" Offset="0.5"/>
                    <GradientStop Color="#e11d48" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <Border Background="#33ffffff" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="📊 HỆ THỐNG KHO MÁU &amp; CẢNH BÁO AN TOÀN DUYỆT TỒN KHO" Foreground="White" FontSize="11" FontWeight="Black"/>
                    </Border>
                    <TextBlock Text="Thống Kê Tồn Kho &amp; Cảnh Báo Cạn Kiệt Máu" Foreground="White" FontSize="22" FontWeight="Black"/>
                    <TextBlock Text="Theo dõi tình trạng dung lượng 8 nhóm máu tại Bệnh viện, cảnh báo cạn kiệt nguồn cung cấp cứu" 
                               Foreground="#ffedd5" FontSize="12" FontWeight="Medium" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 KPI Metric Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Tổng túi máu -->
            <Border Grid.Column="0" Background="White" BorderBrush="#ffedd5" BorderThickness="1.5" CornerRadius="16" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TỔNG TÚI MÁU TỒN KHO" FontSize="10" FontWeight="Black" Foreground="#64748b"/>
                        <TextBlock x:Name="txtKpiTotalUnits" Text="0" FontSize="22" FontWeight="Black" Foreground="#0f172a" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#fff7ed" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🩸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 2: TNV Mới -->
            <Border Grid.Column="2" Background="White" BorderBrush="#ffedd5" BorderThickness="1.5" CornerRadius="16" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TÌNH NGUYỆN VIÊN MỚI" FontSize="10" FontWeight="Black" Foreground="#64748b"/>
                        <TextBlock x:Name="txtKpiVolunteers" Text="0" FontSize="22" FontWeight="Black" Foreground="#0f172a" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#eff6ff" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="👥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 3: Chiến Dịch -->
            <Border Grid.Column="4" Background="White" BorderBrush="#ffedd5" BorderThickness="1.5" CornerRadius="16" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="ĐỢT HIẾN ĐANG DIỄN RA" FontSize="10" FontWeight="Black" Foreground="#64748b"/>
                        <TextBlock x:Name="txtKpiCampaigns" Text="0" FontSize="22" FontWeight="Black" Foreground="#0f172a" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#f0fdf4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- KPI 4: Tỷ lệ vi sinh -->
            <Border Grid.Column="6" Background="White" BorderBrush="#ffedd5" BorderThickness="1.5" CornerRadius="16" Padding="16,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="TỶ LỆ ĐẠT VI SINH" FontSize="10" FontWeight="Black" Foreground="#15803d"/>
                        <TextBlock x:Name="txtKpiPassRate" Text="100%" FontSize="22" FontWeight="Black" Foreground="#15803d" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="10" Background="#f0fdf4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="✅" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Fixed Toolbar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#ffedd5" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch" Grid.Column="0" Height="40" Padding="14,0" BorderBrush="#fed7aa" BorderThickness="1.5" 
                         VerticalContentAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#0f172a" 
                         TextChanged="txtSearch_TextChanged" Tag="🔍 Tìm theo mã kho, tên kho, nhóm máu..."/>

                <ComboBox x:Name="cbFilterStatus" Grid.Column="2" Height="40" VerticalContentAlignment="Center" 
                          FontSize="12" FontWeight="Black" Foreground="#0f172a" SelectionChanged="cbFilterStatus_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái tồn kho" IsSelected="True" Tag="ALL"/>
                    <ComboBoxItem Content="AN TOÀN (>= 50 túi)" Tag="AN_TOAN"/>
                    <ComboBoxItem Content="CẠN KIỆT (&lt; 50 túi)" Tag="CAN_KIET"/>
                </ComboBox>

                <Button x:Name="btnRefresh" Grid.Column="4" Content="LÀM MỚI" Height="40" 
                        Background="#fff7ed" BorderBrush="#fed7aa" BorderThickness="1" Foreground="#c2410c" 
                        FontWeight="Black" FontSize="12" Cursor="Hand" Click="btnRefresh_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main DataGrid (Only DataGrid Scrolls Vertically) -->
        <Border Grid.Row="4" CornerRadius="18" Background="White" BorderBrush="#ffedd5" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgKhoMau" Margin="-1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Kho" Binding="{Binding MaKho}" Width="120"/>
                    <DataGridTextColumn Header="Tên Kho Máu" Binding="{Binding TenKho}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="Nhóm Máu" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#c2410c" Padding="14,4" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NhomMauString}" Foreground="White" FontWeight="Black" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Số Lượng Tồn (Túi)" Binding="{Binding SoLuongTon, StringFormat={}{0} túi}" Width="150"/>
                    <DataGridTextColumn Header="Ngưỡng An Toàn" Binding="{Binding NguongAnToan, StringFormat={}{0} túi}" Width="140"/>

                    <DataGridTemplateColumn Header="Tình Trạng Kỹ Thuật" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TinhTrangBg}" BorderBrush="{Binding TinhTrangBorder}" BorderThickness="1" Padding="12,4" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TinhTrangHienThi}" Foreground="{Binding TinhTrangFg}" FontWeight="Black" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
