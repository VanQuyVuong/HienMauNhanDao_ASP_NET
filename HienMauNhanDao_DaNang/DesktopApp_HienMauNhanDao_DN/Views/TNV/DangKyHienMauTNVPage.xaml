<Page x:Class="DesktopApp_HienMauNhanDao_DN.Views.TNV.DangKyHienMauTNVPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="1150"
      Title="Đăng Ký Hiến Máu TNV">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#0f172a" CornerRadius="16" Padding="20,16" Margin="0,0,0,16">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📝 ĐĂNG KÝ THAM GIA HIẾN MÁU" Foreground="White" FontSize="18" FontWeight="Black"/>
                    <TextBlock Text="Chọn chiến dịch hiến máu, khung thời gian tiện lợi và dung tích máu muốn đăng ký" Foreground="#cbd5e1" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORM & CAMPAIGN SELECTOR -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: CAMPAIGN SELECTION LIST -->
            <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="SELECT BƯỚC 1: CHỌN CHIẾN DỊCH HIẾN MÁU" Foreground="#0f172a" FontSize="13" FontWeight="Black" Margin="0,0,0,12"/>

                    <ListBox x:Name="lbCampaigns" Grid.Row="1" BorderThickness="0" SelectionChanged="lbCampaigns_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TenChienDich}" FontWeight="Bold" FontSize="13" Foreground="#0f172a"/>
                                            <TextBlock Text="{Binding DiaDiemString}" FontSize="11" Foreground="#64748b" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding ThoiGianBD}" FontSize="11" Foreground="#0284c7" FontWeight="Bold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#dc2626" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                            <TextBlock Text="CHỌN" Foreground="White" FontWeight="Black" FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: REGISTRATION DETAILS FORM -->
            <Border Grid.Column="2" Background="White" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="BƯỚC 2: THÔNG TIN ĐĂNG KÝ" Foreground="#0f172a" FontSize="14" FontWeight="Black" Margin="0,0,0,14"/>

                    <TextBlock Text="CHIẾN DỊCH ĐÃ CHỌN" FontSize="10" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,4"/>
                    <Border Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                        <TextBlock x:Name="txtSelectedCampaignName" Text="Chưa chọn chiến dịch nào" Foreground="#0369a1" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <TextBlock Text="KHUNG GIỜ ĐẾN HIẾN MÁU *" FontSize="10" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cbTimeSlot" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14">
                        <ComboBoxItem Content="Ca sáng: 07:30 - 09:00" IsSelected="True"/>
                        <ComboBoxItem Content="Ca sáng: 09:00 - 10:30"/>
                        <ComboBoxItem Content="Ca chiều: 13:30 - 15:00"/>
                        <ComboBoxItem Content="Ca chiều: 15:00 - 16:30"/>
                    </ComboBox>

                    <TextBlock Text="DUNG TÍCH ĐĂNG KÝ *" FontSize="10" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cbVolume" Height="38" Padding="10,0" VerticalContentAlignment="Center" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,14">
                        <ComboBoxItem Content="350 ml (Dung tích tiêu chuẩn)" IsSelected="True"/>
                        <ComboBoxItem Content="250 ml (Người hiến lần đầu / cân nặng nhỏ)"/>
                        <ComboBoxItem Content="450 ml (Thể trạng tốt / cân nặng > 60kg)"/>
                    </ComboBox>

                    <TextBlock Text="GHI CHÚ / YÊU CẦU ĐẶC BIỆT" FontSize="10" FontWeight="Black" Foreground="#64748b" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtNotes" Height="60" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" FontSize="12" Margin="0,0,0,20"/>

                    <Button x:Name="btnSubmitRegistration" Content="🚀 XÁC NHẬN ĐĂNG KÝ HIẾN MÁU" Height="44" Background="#dc2626" Foreground="White" FontWeight="Black" FontSize="13" Cursor="Hand" Click="btnSubmitRegistration_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
